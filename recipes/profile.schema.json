{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rundesk:runtime-profile:1",
  "title": "RunDesk runtime profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "runtime",
    "id",
    "title",
    "description",
    "searchBackends",
    "defaultSearchBackend",
    "aptPackages",
    "pythonPackages",
    "skill",
    "tools",
    "outputs",
    "resources",
    "optionalComponents"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "const": "codex-docker"
    },
    "searchBackends": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "exa",
          "none"
        ]
      }
    },
    "defaultSearchBackend": {
      "enum": [
        "exa",
        "none"
      ]
    },
    "aptPackages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9+.-]*$"
      }
    },
    "pythonPackages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "skill": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,64}$"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpus",
        "memoryMB",
        "network"
      ],
      "properties": {
        "cpus": {
          "type": "integer",
          "minimum": 1
        },
        "memoryMB": {
          "type": "integer",
          "minimum": 256
        },
        "network": {
          "enum": [
            "bridge",
            "none"
          ]
        }
      }
    },
    "optionalComponents": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "agent-reach",
          "video-use"
        ]
      }
    },
    "skillFiles": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "upstream": {
      "const": "upstream.json"
    }
  },
  "$defs": {
    "contextRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*[\\\\:\\u0000-\\u001f\\u007f-\\u009f])[^/]+(?:/[^/]+)*$",
      "not": {
        "pattern": "(^|/)\\.{1,2}(/|$)"
      },
      "description": "Ordinary relative POSIX path: no absolute path, colon, backslash, control character, empty segment, dot or parent component."
    },
    "sharedFiles": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/contextRelativePath"
      },
      "additionalProperties": {
        "$ref": "#/$defs/contextRelativePath"
      },
      "description": "Authoring-only context destination -> file or directory beneath recipes/common. Runtime validation also rejects overlapping destinations, generated metadata targets, links/special files, file/directory conflicts and missing shared inputs. All shared plus local input files fit the combined 4000-file/128-MiB limit. Ordinary same-path local files override shared files; exported contexts materialize real files and omit this field."
    },
    "canonicalRecipe": {
      "title": "RunDesk canonical recipe descriptor",
      "type": "object",
      "required": [
        "schemaVersion",
        "profile"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "profile": {
          "$ref": "#"
        },
        "sharedFiles": {
          "$ref": "#/$defs/sharedFiles"
        }
      },
      "description": "Use profile.schema.json#/$defs/canonicalRecipe for recipe.json; the document root continues to validate only the nested runtime profile. Existing dependency, selection and upstream declaration fields retain their dedicated runtime validation."
    }
  }
}
