+
+func TestTaskResourceViewDoesNotAttributeLaterNativeTurn(t *testing.T) {
+	m := testManager(t)
+	task := pausedResourceTask(t, m)
+	m.queueMu.Lock()
+	task.RunID, task.Status = "original-run", "completed"
