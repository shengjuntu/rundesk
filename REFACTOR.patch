+		if data, ok := strings.CutPrefix(scanner.Text(), "data: "); ok {
+			if err := json.Unmarshal([]byte(data), &first); err != nil {
+				t.Fatal(err)
+			}
+			break
+		}
+	}
+	res.Body.Close()
+	if first["type"] != "response.created" {
+		t.Fatalf("stream buffered/invalid first event: %v (%v)", first, scanner.Err())
