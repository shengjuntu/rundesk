+	if err := os.RemoveAll(dir); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(filepath.Dir(outside), dir); err != nil {
+		t.Fatal(err)
+	}
+	_, err = f.DiscoverArtifacts("actor", "hsessone", s.ID, "cntr_one")
+	uhpFileErrorCode(t, err, 409, "rundesk_file_source_invalid")
+}
