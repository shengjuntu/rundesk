diff --git a/internal/app/uhp_input.go b/internal/app/uhp_input.go
new file mode 100644
index 0000000..3c58ccb
--- /dev/null
+++ b/internal/app/uhp_input.go
@@ -0,0 +1,253 @@
+package app
+
+import (
+	"bytes"
+	"encoding/json"
+	"io"
+	"sort"
+	"strings"
+)
+
+// Inline base64 is bounded independently of the upload endpoint. Large clients
+// should upload once, then reference the file id rather than repeat the bytes.
+const uhpRequestLimit = 8 << 20
+
+type uhpRequest struct {
+	Input              json.RawMessage `json:"input"`
+	Metadata           map[string]any  `json:"metadata"`
+	Model              string          `json:"model"`
+	PreviousResponseID string          `json:"previous_response_id"`
+	Instructions       string          `json:"instructions"`
+	Stream             bool            `json:"stream"`
+	Background         bool            `json:"background"`
+	Store              *bool           `json:"store"`
+	MaxStep            *int            `json:"max_step"`
+	TimeoutSeconds     *int            `json:"timeout_seconds"`
+	MaxOutputTokens    *int            `json:"max_output_tokens"`
+	IgnoredFields      []string        `json:"-"`
+	InstructionMode    string          `json:"-"`
+}
+
+func parseUHPRequest(reader io.Reader) (uhpRequest, error) {
+	var out uhpRequest
+	b, err := io.ReadAll(io.LimitReader(reader, uhpRequestLimit+1))
+	if err != nil {
+		return out, failure(400, "invalid_input", "The request body could not be read.")
+	}
+	if len(b) > uhpRequestLimit {
+		return out, failure(413, "file_too_large", "The inline request exceeds the 8 MiB limit; use a file upload.")
+	}
+	var fields map[string]json.RawMessage
+	if json.Unmarshal(b, &fields) != nil || fields == nil {
+		return out, failure(400, "invalid_input", "The request must be one JSON object.")
+	}
+	known := map[string]any{"input": &out.Input, "metadata": &out.Metadata, "model": &out.Model, "previous_response_id": &out.PreviousResponseID, "instructions": &out.Instructions, "stream": &out.Stream, "background": &out.Background, "store": &out.Store, "max_step": &out.MaxStep, "timeout_seconds": &out.TimeoutSeconds, "max_output_tokens": &out.MaxOutputTokens}
+	for name, target := range known {
+		if raw, ok := fields[name]; ok && json.Unmarshal(raw, target) != nil {
+			return out, failure(400, "invalid_input", "A request field has the wrong type.")
+		}
+	}
+	for name, raw := range fields {
+		switch name {
+		case "input", "model", "metadata", "instructions", "stream", "background", "store":
+			if bytes.Equal(bytes.TrimSpace(raw), []byte("null")) {
+				return out, failure(400, "invalid_input", "A required field value cannot be null.")
+			}
+		case "previous_response_id", "max_step", "timeout_seconds":
+		case "max_output_tokens":
+			out.IgnoredFields = append(out.IgnoredFields, name)
+		case "tools":
+			var tools []map[string]any
+			if json.Unmarshal(raw, &tools) != nil || tools == nil {
+				return out, failure(400, "invalid_input", "tools must be an array of objects.")
+			}
+			for _, tool := range tools {
+				if tool == nil {
+					return out, failure(400, "invalid_input", "tools must be an array of objects.")
+				}
+			}
+			out.IgnoredFields = append(out.IgnoredFields, name)
+		case "include":
+			var values []string
+			if json.Unmarshal(raw, &values) != nil || values == nil {
+				return out, failure(400, "invalid_input", "include must be an array of strings.")
+			}
+			out.IgnoredFields = append(out.IgnoredFields, name)
+		default:
+			out.IgnoredFields = append(out.IgnoredFields, name)
+		}
+	}
+	if len(out.Input) == 0 {
+		return out, failure(400, "invalid_input", "input is required.")
+	}
+	if out.Metadata == nil {
+		out.Metadata = map[string]any{}
+	}
+	if id, ok := out.Metadata["harness_id"]; ok {
+		if _, valid := id.(string); !valid {
+			return out, failure(400, "invalid_input", "metadata.harness_id must be a string.")
+		}
+	}
+	for _, budget := range []*int{out.MaxStep, out.TimeoutSeconds, out.MaxOutputTokens} {
+		if budget != nil && *budget < 1 {
+			return out, failure(400, "invalid_input", "Budgets must be positive integers.")
+		}
+	}
+	if out.TimeoutSeconds != nil && *out.TimeoutSeconds > 86400 {
+		return out, failure(400, "invalid_input", "timeout_seconds must not exceed 86400.")
+	}
+	if len(out.Model) > 160 || len(out.PreviousResponseID) > 160 || len(out.Instructions) > 64<<10 {
+		return out, failure(400, "invalid_input", "A request field exceeds its size limit.")
+	}
+	if out.Instructions != "" {
+		out.InstructionMode = "task_text"
+	}
+	var messages []uhpInputMessage
+	if json.Unmarshal(out.Input, &messages) == nil {
+		for _, message := range messages {
+			if message.Role == "system" || message.Role == "developer" {
+				out.InstructionMode = "task_text"
+			}
+		}
+	}
+	sort.Strings(out.IgnoredFields)
+	return out, nil
+}
+
+type uhpInputPart struct {
+	Type     string `json:"type"`
+	Text     string `json:"text"`
+	Filename string `json:"filename"`
+	FileID   string `json:"file_id"`
+	FileData string `json:"file_data"`
+	ImageURL string `json:"image_url"`
+}
+type uhpInputMessage struct {
+	Type    string          `json:"type"`
+	Role    string          `json:"role"`
+	Content json.RawMessage `json:"content"`
+}
+
+func uhpContentParts(raw json.RawMessage) ([]uhpInputPart, error) {
+	var text string
+	if json.Unmarshal(raw, &text) == nil && !bytes.Equal(bytes.TrimSpace(raw), []byte("null")) {
+		return []uhpInputPart{{Type: "input_text", Text: text}}, nil
+	}
+	var parts []uhpInputPart
+	if json.Unmarshal(raw, &parts) != nil || parts == nil {
+		return nil, failure(400, "invalid_input", "Message content must be text or an array of content parts.")
+	}
+	return parts, nil
+}
+
+func (s *Server) uhpPrepareInput(req uhpRequest, owner, wid string) (Input, error) {
+	out := Input{Files: []string{}}
+	var text string
+	var selected []uhpInputPart
+	guidance := []string{}
+	if req.Instructions != "" {
+		guidance = append(guidance, req.Instructions)
+	}
+	if json.Unmarshal(req.Input, &text) == nil && !bytes.Equal(bytes.TrimSpace(req.Input), []byte("null")) {
+		selected = []uhpInputPart{{Type: "input_text", Text: text}}
+	} else {
+		var messages []uhpInputMessage
+		if json.Unmarshal(req.Input, &messages) != nil || len(messages) == 0 {
+			return out, failure(400, "invalid_input", "input must be text or a non-empty array of messages.")
+		}
+		for _, msg := range messages {
+			if msg.Type != "" && msg.Type != "message" {
+				return out, failure(400, "invalid_input", "Only message input items are supported.")
+			}
+			parts, err := uhpContentParts(msg.Content)
+			if err != nil {
+				return out, err
+			}
+			switch msg.Role {
+			case "", "user":
+				// input_history is false: only the last user message is a new
+				// task; earlier assistant messages are not imported turns.
+				selected = parts
+			case "system", "developer":
+				for _, part := range parts {
+					if part.Type != "input_text" && part.Type != "output_text" {
+						return out, failure(400, "invalid_input", "Task guidance accepts text only.")
+					}
+					guidance = append(guidance, part.Text)
+				}
+			case "assistant":
+				for _, part := range parts {
+					if part.Type != "input_text" && part.Type != "output_text" {
+						return out, failure(400, "invalid_input", "Assistant history accepts text only.")
+					}
+				}
+			default:
+				return out, failure(400, "invalid_input", "The message role is not supported.")
+			}
+		}
+	}
+	if len(selected) == 0 {
+		return out, failure(400, "invalid_input", "The input must include a user message.")
+	}
+	texts := []string{}
+	for _, part := range selected {
+		switch part.Type {
+		case "input_text":
+			texts = append(texts, part.Text)
+		case "input_file", "input_image":
+			inline := part.FileData
+			if part.ImageURL != "" {
+				if inline != "" {
+					return out, failure(400, "invalid_input", "An input file must have one source.")
+				}
+				inline = part.ImageURL
+			}
+			if (part.FileID == "") == (inline == "") {
+				return out, failure(400, "invalid_input", "An input file needs exactly one of file_id or inline data.")
+			}
+			var path string
+			var err error
+			files := uhpFiles{Manager: s.Manager}
+			if part.FileID != "" {
+				if part.Type == "input_image" {
+					path, err = files.PrepareImageInput(owner, wid, part.FileID)
+				} else {
+					path, err = files.PrepareInput(owner, wid, part.FileID)
+				}
+			} else {
+				if !strings.HasPrefix(inline, "data:") {
+					return out, failure(422, "rundesk_remote_image_unsupported", "Remote file URLs are not supported; use a data URL or upload.")
+				}
+				name := part.Filename
+				if name == "" {
+					name = "input.bin"
+				}
+				if part.Type == "input_image" {
+					path, err = files.InlineImage(owner, wid, name, inline)
+				} else {
+					path, err = files.Inline(owner, wid, name, inline)
+				}
+			}
+			if err != nil {
+				return out, err
+			}
+			out.Files = append(out.Files, path)
+		default:
+			return out, failure(400, "invalid_input", "The input content type is not supported.")
+		}
+	}
+	out.Text = strings.Join(texts, "\n")
+	if strings.TrimSpace(out.Text) == "" && len(out.Files) > 0 {
+		out.Text = "Process the attached files."
+	}
+	if len(guidance) > 0 {
+		// RunDesk's native input contract has no per-turn system-role field.
+		// Preserve guidance explicitly as task text, without changing global
+		// harness instructions or claiming a different instruction priority.
+		out.Text = "Additional task guidance:\n" + strings.Join(guidance, "\n") + "\n\nTask:\n" + out.Text
+	}
+	if strings.TrimSpace(out.Text) == "" || len(out.Text) > 256<<10 || len(out.Files) > 64 {
+		return out, failure(400, "invalid_input", "Task input exceeds the text or attachment limit, or is empty.")
+	}
+	return out, nil
+}
diff --git a/internal/app/uhp_input_test.go b/internal/app/uhp_input_test.go
new file mode 100644
index 0000000..6929ac3
--- /dev/null
+++ b/internal/app/uhp_input_test.go
@@ -0,0 +1,184 @@
+package app
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http/httptest"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/shengjuntu/rundesk/internal/store"
+)
+
+func TestUHPRequestIgnoredFieldsAreExactAndUnknownFieldsHaveNoEffect(t *testing.T) {
+	req, err := parseUHPRequest(strings.NewReader(`{"input":"work","Input":"not work","stream":false,"Stream":true,"tools":[],"include":[],"max_output_tokens":100,"future":{"anything":true}}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(req.Input) != `"work"` || req.Stream {
+		t.Fatal("unknown case variants affected request", req)
+	}
+	if !reflect.DeepEqual(req.IgnoredFields, []string{"Input", "Stream", "future", "include", "max_output_tokens", "tools"}) {
+		t.Fatal(req.IgnoredFields)
+	}
+	plain, err := parseUHPRequest(strings.NewReader(`{"input":"work","previous_response_id":null,"max_step":null,"timeout_seconds":null}`))
+	if err != nil || len(plain.IgnoredFields) != 0 || plain.MaxStep != nil || plain.TimeoutSeconds != nil {
+		t.Fatal(plain, err)
+	}
+}
+
+func TestUHPRequestRejectsMalformedTypedFields(t *testing.T) {
+	for _, body := range []string{
+		`null`, `[]`, `{}`, `{"input":"x"} {"input":"y"}`, `{"Input":"x"}`,
+		`{"input":null}`, `{"input":"x","stream":null}`, `{"input":"x","stream":"true"}`,
+		`{"input":"x","metadata":[]}`, `{"input":"x","metadata":{"harness_id":3}}`,
+		`{"input":"x","max_step":1.1}`, `{"input":"x","max_step":0}`, `{"input":"x","timeout_seconds":-1}`,
+		`{"input":"x","tools":{}}`, `{"input":"x","tools":[null]}`, `{"input":"x","include":[7]}`,
+	} {
+		t.Run(body, func(t *testing.T) {
+			if _, err := parseUHPRequest(strings.NewReader(body)); err == nil {
+				t.Fatal("accepted malformed request")
+			}
+		})
+	}
+}
+
+func TestUHPInputHistoryUsesLastUserAndPreservesGuidance(t *testing.T) {
+	req, err := parseUHPRequest(strings.NewReader(`{"input":[{"role":"user","content":"old user"},{"role":"assistant","content":[{"type":"output_text","text":"old answer"}]},{"role":"system","content":"be brief"},{"role":"user","content":[{"type":"input_text","text":"new task"}]}],"instructions":"cite evidence"}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if req.InstructionMode != "task_text" {
+		t.Fatal("instruction priority was not disclosed")
+	}
+	in, err := (&Server{}).uhpPrepareInput(req, "owner", "workspace")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(in.Text, "old user") || strings.Contains(in.Text, "old answer") || !strings.Contains(in.Text, "be brief") || !strings.Contains(in.Text, "cite evidence") || !strings.HasSuffix(in.Text, "new task") {
+		t.Fatal(in.Text)
+	}
+}
+
+func TestUHPHarnessCatalogDoesNotCrossDedicatedPresetResources(t *testing.T) {
+	m := testManager(t)
+	w, err := m.CreateWorkspace("preset workspace", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	i, err := m.CreateInstance(InstancePatch{Name: "preset instance"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	p := ApplicationRuntimePreset{ID: "production", AppID: "app", InstanceID: i.ID, WorkspaceID: w.ID, Name: "Production", Enabled: true}
+	if err := m.Store.Put("application-runtime-preset", applicationPresetKey(p.AppID, p.ID), p); err != nil {
+		t.Fatal(err)
+	}
+	s := &Server{Manager: m}
+	items, err := s.uhpHarnesses(httptest.NewRequest("GET", "/v1/harnesses", nil))
+	if err != nil {
+		t.Fatal(err)
+	}
+	count := 0
+	for _, h := range items {
+		if h.InstanceID == i.ID || h.WorkspaceID == w.ID {
+			count++
+			if h.InstanceID != i.ID || h.WorkspaceID != w.ID || h.Source.AppID != p.AppID || h.Source.PresetID != p.ID {
+				t.Fatal("preset resource crossed into generic harness", h)
+			}
+		}
+	}
+	if count != 1 {
+		t.Fatal("preset harness missing or duplicated", items)
+	}
+	p.Enabled = false
+	if err := m.Store.PutMany(store.Record{Kind: "application-runtime-preset", ID: applicationPresetKey(p.AppID, p.ID), Value: p}); err != nil {
+		t.Fatal(err)
+	}
+	items, err = s.uhpHarnesses(httptest.NewRequest("GET", "/v1/harnesses", nil))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, h := range items {
+		if h.InstanceID == i.ID || h.WorkspaceID == w.ID {
+			t.Fatal("disabled preset exposed", h)
+		}
+	}
+}
+
+func TestUHPInputFilesAreMaterializedAndRemoteURLsRefused(t *testing.T) {
+	m := testManager(t)
+	s := &Server{Manager: m}
+	w := m.Workspaces()[0]
+	req, err := parseUHPRequest(strings.NewReader(`{"input":[{"role":"user","content":[{"type":"input_text","text":"read"},{"type":"input_file","filename":"note.txt","file_data":"data:text/plain;base64,aGVsbG8="}]}]}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	in, err := s.uhpPrepareInput(req, "owner", w.ID)
+	if err != nil || len(in.Files) != 1 || !strings.HasPrefix(in.Files[0], "uploads/") {
+		t.Fatal(in, err)
+	}
+	if err := m.validateInput(w, in); err != nil {
+		t.Fatal(err)
+	}
+	req.Input = json.RawMessage(`[{"role":"user","content":[{"type":"input_image","image_url":"http://127.0.0.1/private"}]}]`)
+	_, err = s.uhpPrepareInput(req, "owner", w.ID)
+	var ae *apiError
+	if !errors.As(err, &ae) || ae.Code != "rundesk_remote_image_unsupported" {
+		t.Fatal(err)
+	}
+}
+
+func TestUHPHarnessCatalogScopesBindingsAndStableIDs(t *testing.T) {
+	m := testManager(t)
+	w := m.Workspaces()[0]
+	_, k, _ := setupKey(t, m, "uhp-catalog", w.ID, "read", "run")
+	_, err := m.CreateWorkspace("private", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := &Server{Manager: m}
+	r := httptest.NewRequest("GET", "/v1/harnesses", nil)
+	r = r.WithContext(context.WithValue(r.Context(), applicationPrincipal{}, &k))
+	items, err := s.uhpHarnesses(r)
+	if err != nil || len(items) != 1 {
+		t.Fatal(items, err)
+	}
+	h := items[0]
+	if h.WorkspaceID != w.ID || h.InstanceID != k.InstanceID || h.Source.AppID != k.AppID || !strings.HasPrefix(h.ID, "chrn_") {
+		t.Fatal(h)
+	}
+	i, _ := m.Instance(k.InstanceID)
+	if _, err := m.PatchInstance(i.ID, InstancePatch{Name: "renamed", Revision: i.Revision}); err != nil {
+		t.Fatal(err)
+	}
+	again, err := s.uhpHarnesses(r)
+	if err != nil || len(again) != 1 || again[0].ID != h.ID {
+		t.Fatal(again, err)
+	}
+	wire, _ := json.Marshal(h.Wire())
+	if strings.Contains(string(wire), w.Path) || strings.Contains(string(wire), i.CodexHome) {
+		t.Fatal("catalog leaked native paths")
+	}
+}
+
+func TestUHPModelSelectionUsesNativeCatalogAndRejectsSubstitution(t *testing.T) {
+	m := testManager(t)
+	s := &Server{Manager: m}
+	harnesses, err := s.uhpHarnesses(httptest.NewRequest("GET", "/v1/harnesses", nil))
+	if err != nil || len(harnesses) == 0 {
+		t.Fatal(harnesses, err)
+	}
+	h := harnesses[0]
+	model, err := s.uhpSelectModel(h, "")
+	if err != nil || model != "demo-fixture" {
+		t.Fatal(model, err)
+	}
+	_, err = s.uhpSelectModel(h, "not-in-native-catalog")
+	var ae *apiError
+	if !errors.As(err, &ae) || ae.Code != "model_unavailable" || ae.Status != 422 {
+		t.Fatal(err)
+	}
+}
diff --git a/internal/app/uhp_projection.go b/internal/app/uhp_projection.go
new file mode 100644
index 0000000..eeb7d42
--- /dev/null
+++ b/internal/app/uhp_projection.go
@@ -0,0 +1,604 @@
+package app
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"strings"
+
+	"github.com/shengjuntu/rundesk/internal/store"
+)
+
+// The projection is a durable view of the native journal, not another execution
+// engine. HTTP polling and SSE both read this same response and event sequence.
+type uhpResponse struct {
+	ID                 string           `json:"id"`
+	Object             string           `json:"object"`
+	CreatedAt          int64            `json:"created_at"`
+	Status             string           `json:"status"`
+	Error              *uhpError        `json:"error"`
+	IncompleteDetails  map[string]any   `json:"incomplete_details"`
+	PreviousResponseID *string          `json:"previous_response_id"`
+	Model              string           `json:"model"`
+	Output             []map[string]any `json:"output"`
+	Store              bool             `json:"store"`
+	Usage              map[string]any   `json:"usage"`
+	Metadata           map[string]any   `json:"metadata"`
+}
+
+type uhpProjectedItem struct {
+	Index      int      `json:"index"`
+	Kind       string   `json:"kind"`
+	Text       string   `json:"text,omitempty"`
+	Arguments  string   `json:"arguments,omitempty"`
+	Summary    []string `json:"summary,omitempty"`
+	NativeDone bool     `json:"native_done,omitempty"`
+	Done       bool     `json:"done,omitempty"`
+}
+
+type uhpProjection struct {
+	Response       uhpResponse                  `json:"response"`
+	Events         []map[string]any             `json:"events"`
+	Items          map[string]*uhpProjectedItem `json:"items"`
+	LastSourceID   int64                        `json:"last_source_id"`
+	Admitted       bool                         `json:"admitted"`
+	Started        bool                         `json:"started"`
+	NativeTurnID   string                       `json:"native_turn_id,omitempty"`
+	TurnRequestID  string                       `json:"turn_request_id,omitempty"`
+	PendingNative  []store.Event                `json:"pending_native,omitempty"`
+	Steps          int                          `json:"steps,omitempty"`
+	ToolCalls      int                          `json:"tool_calls,omitempty"`
+	KunUsage       map[string]int64             `json:"kun_usage,omitempty"`
+	KunUsageKnown  bool                         `json:"kun_usage_known,omitempty"`
+	KunUsageAbsent bool                         `json:"kun_usage_absent,omitempty"`
+}
+
+func newUHPProjection(r uhpResponse) uhpProjection {
+	r.Object, r.Status = "response", "in_progress"
+	if r.Output == nil {
+		r.Output = []map[string]any{}
+	}
+	if r.Metadata == nil {
+		r.Metadata = map[string]any{}
+	}
+	p := uhpProjection{Response: r, Events: []map[string]any{}, Items: map[string]*uhpProjectedItem{}}
+	p.emit("response.created", map[string]any{"response": r})
+	return p
+}
+
+func (p *uhpProjection) emit(kind string, fields map[string]any) {
+	// Snapshots must not share mutable maps with current output. In particular,
+	// response.created must stay in_progress after the response completes.
+	b, _ := json.Marshal(fields)
+	var event map[string]any
+	_ = json.Unmarshal(b, &event)
+	if event == nil {
+		event = map[string]any{}
+	}
+	event["type"], event["sequence_number"] = kind, len(p.Events)
+	p.Events = append(p.Events, event)
+}
+
+func (p *uhpProjection) begin() {
+	if !p.Started {
+		p.Started = true
+		p.emit("response.in_progress", map[string]any{"response": p.Response})
+	}
+}
+
+// Apply consumes a persisted host event. The caller supplies a task's RunID and
+// an admission cursor. Duplicate journal reads and foreign runs are harmless.
+// Codex notifications are bound to the turn/start RPC response, rather than to
+// whichever turn/started notification happened to arrive first.
+func (p *uhpProjection) Apply(event store.Event, runID string) {
+	if p.Response.Status != "in_progress" || runID == "" || event.ID <= p.LastSourceID {
+		return
+	}
+	p.LastSourceID = event.ID
+	var raw map[string]any
+	if json.Unmarshal(event.Data, &raw) != nil {
+		return
+	}
+	if event.Method == "run/input" {
+		p.Admitted = uhpString(raw["runId"]) == runID
+		if p.Admitted {
+			p.begin()
+		}
+		return
+	}
+	if strings.HasPrefix(event.Method, "kun/") {
+		if uhpString(raw["runId"]) == runID {
+			p.begin()
+			p.kunEvent(event, raw)
+		}
+		return
+	}
+	if !p.Admitted {
+		return
+	}
+	if event.Direction == "out" && event.Method == "turn/start" {
+		p.TurnRequestID = uhpJSON(raw["id"])
+		return
+	}
+	if event.Direction != "in" {
+		return
+	}
+	if event.Method == "" && p.TurnRequestID != "" && uhpJSON(raw["id"]) == p.TurnRequestID {
+		turn := uhpMap(uhpMap(raw["result"])["turn"])
+		if id := uhpString(turn["id"]); id != "" {
+			p.NativeTurnID = id
+		}
+	}
+	if p.NativeTurnID != "" && len(p.PendingNative) > 0 {
+		pending := p.PendingNative
+		p.PendingNative = nil
+		for _, saved := range pending {
+			var v map[string]any
+			if json.Unmarshal(saved.Data, &v) == nil {
+				p.codexEvent(saved, v)
+			}
+		}
+	}
+	if !strings.HasPrefix(event.Method, "item/") && event.Method != "turn/started" {
+		return
+	}
+	if p.NativeTurnID == "" {
+		p.PendingNative = append(p.PendingNative, event)
+		return
+	}
+	p.codexEvent(event, raw)
+}
+
+func (p *uhpProjection) codexEvent(event store.Event, raw map[string]any) {
+	params := uhpMap(raw["params"])
+	turnID := uhpString(params["turnId"])
+	if turnID == "" && event.Method == "turn/started" {
+		turnID = uhpString(uhpMap(params["turn"])["id"])
+	}
+	if turnID == "" || turnID != p.NativeTurnID {
+		return
+	}
+	item := uhpMap(params["item"])
+	id := uhpString(params["itemId"])
+	if id == "" {
+		id = uhpString(item["id"])
+	}
+	if id == "" {
+		return
+	}
+	key := "codex:" + id
+	switch event.Method {
+	case "item/agentMessage/delta":
+		state := p.message(key)
+		p.textDelta(state, uhpString(params["delta"]))
+	case "item/reasoning/summaryTextDelta":
+		state := p.reasoning(key)
+		index := uhpInt(params["summaryIndex"])
+		p.summaryDelta(state, index, uhpString(params["delta"]))
+	case "item/reasoning/summaryPartAdded":
+		state := p.reasoning(key)
+		p.summaryPart(state, uhpInt(params["summaryIndex"]))
+	case "item/started", "item/completed":
+		done := event.Method == "item/completed"
+		switch uhpString(item["type"]) {
+		case "agentMessage":
+			state := p.message(key)
+			if done {
+				p.completeText(state, uhpString(item["text"]))
+				state.NativeDone = true
+			}
+		case "reasoning":
+			state := p.reasoning(key)
+			if done {
+				for n, part := range uhpArray(item["summary"]) {
+					text := uhpString(part)
+					if text == "" {
+						text = uhpString(uhpMap(part)["text"])
+					}
+					p.summaryPart(state, n)
+					if n < len(state.Summary) && strings.HasPrefix(text, state.Summary[n]) {
+						p.summaryDelta(state, n, strings.TrimPrefix(text, state.Summary[n]))
+					}
+				}
+				p.closeItem(state, "completed")
+			}
+		default:
+			name, args, output, supported := uhpCodexTool(item)
+			if !supported {
+				return
+			}
+			state := p.tool(key, name, args)
+			if done {
+				p.completeArguments(state, args)
+				p.closeItem(state, "completed")
+				p.toolResult(key, output)
+			}
+		}
+	}
+}
+
+func (p *uhpProjection) kunEvent(event store.Event, raw map[string]any) {
+	data := uhpMap(raw["data"])
+	step := uhpInt(data["step"])
+	key := fmt.Sprintf("kun:model:%v", raw["sequence"])
+	switch event.Method {
+	case "kun/model.completed", "kun/fast.completed":
+		if step > p.Steps {
+			p.Steps = step
+		}
+		p.kunUsage(uhpMap(data["usage"]))
+		// Kun's planning content is not a public reasoning summary. It stays in
+		// the native trace and is never exposed as the assistant's final answer.
+		if uhpString(data["purpose"]) == "plan" || uhpString(data["status"]) == "rejected" {
+			return
+		}
+		message := uhpMap(data["message"])
+		if text := uhpString(message["content"]); text != "" {
+			state := p.message(key)
+			p.completeText(state, text)
+			state.NativeDone = true
+		}
+		for _, value := range uhpArray(message["tool_calls"]) {
+			call := uhpMap(value)
+			function := uhpMap(call["function"])
+			if id := uhpString(call["id"]); id != "" {
+				state := p.tool("kun:tool:"+id, uhpString(function["name"]), uhpString(function["arguments"]))
+				p.completeArguments(state, uhpString(function["arguments"]))
+			}
+		}
+	case "kun/tool.started", "kun/tool.completed":
+		call := uhpMap(data["call"])
+		id := uhpString(call["id"])
+		if id == "" {
+			return
+		}
+		function := uhpMap(call["function"])
+		key = "kun:tool:" + id
+		state := p.tool(key, uhpString(function["name"]), uhpString(function["arguments"]))
+		if event.Method == "kun/tool.completed" {
+			p.completeArguments(state, uhpString(function["arguments"]))
+			p.closeItem(state, "completed")
+			output := uhpString(data["output"])
+			if _, ok := data["output"].(string); !ok {
+				output = uhpJSON(data["output"])
+			}
+			p.toolResult(key, output)
+		}
+	}
+}
+
+func (p *uhpProjection) kunUsage(usage map[string]any) {
+	if len(usage) == 0 {
+		p.KunUsageAbsent = true
+		p.Response.Usage = nil
+		return
+	}
+	values := map[string]int64{}
+	for _, field := range []string{"input_tokens", "output_tokens", "total_tokens", "cache_read_tokens", "cache_write_tokens"} {
+		if value, ok := usage[field].(float64); ok && value >= 0 && value <= 9007199254740991 && value == float64(int64(value)) {
+			values[field] = int64(value)
+		}
+	}
+	if !p.KunUsageKnown {
+		p.KunUsage = values
+	} else {
+		// A task counter is known only when every model call reported it.
+		for field, old := range p.KunUsage {
+			value, exists := values[field]
+			if !exists || old > 9007199254740991-value {
+				delete(p.KunUsage, field)
+			} else {
+				p.KunUsage[field] += value
+			}
+		}
+	}
+	p.KunUsageKnown = true
+	if len(p.KunUsage) == 0 {
+		p.KunUsageAbsent = true
+	}
+	if p.KunUsageKnown && !p.KunUsageAbsent {
+		p.Response.Usage = map[string]any{}
+		for field, value := range p.KunUsage {
+			p.Response.Usage[field] = value
+		}
+	} else {
+		p.Response.Usage = nil
+	}
+}
+
+func (p *uhpProjection) itemID(prefix, key string) string {
+	h := sha256.Sum256([]byte(p.Response.ID + "\x00" + key))
+	return prefix + hex.EncodeToString(h[:12])
+}
+
+func (p *uhpProjection) add(key, kind, prefix string, fields map[string]any) *uhpProjectedItem {
+	if p.Items == nil {
+		p.Items = map[string]*uhpProjectedItem{}
+	}
+	if state := p.Items[key]; state != nil {
+		return state
+	}
+	fields["id"], fields["type"], fields["status"] = p.itemID(prefix, key), kind, "in_progress"
+	state := &uhpProjectedItem{Index: len(p.Response.Output), Kind: kind}
+	p.Response.Output = append(p.Response.Output, fields)
+	p.Items[key] = state
+	p.emit("response.output_item.added", map[string]any{"output_index": state.Index, "item": fields})
+	return state
+}
+
+func (p *uhpProjection) fields(state *uhpProjectedItem) map[string]any {
+	return map[string]any{"output_index": state.Index, "item_id": p.Response.Output[state.Index]["id"]}
+}
+
+func (p *uhpProjection) message(key string) *uhpProjectedItem {
+	if state := p.Items[key]; state != nil {
+		return state
+	}
+	part := map[string]any{"type": "output_text", "text": "", "annotations": []any{}}
+	state := p.add(key, "message", "msg_", map[string]any{"role": "assistant", "content": []any{part}})
+	fields := p.fields(state)
+	fields["content_index"], fields["part"] = 0, part
+	p.emit("response.content_part.added", fields)
+	return state
+}
+
+func (p *uhpProjection) textDelta(state *uhpProjectedItem, delta string) {
+	if state.Done || delta == "" {
+		return
+	}
+	state.Text += delta
+	part := uhpMap(uhpArray(p.Response.Output[state.Index]["content"])[0])
+	part["text"] = state.Text
+	fields := p.fields(state)
+	fields["content_index"], fields["delta"] = 0, delta
+	p.emit("response.output_text.delta", fields)
+}
+
+func (p *uhpProjection) completeText(state *uhpProjectedItem, text string) {
+	if strings.HasPrefix(text, state.Text) {
+		p.textDelta(state, strings.TrimPrefix(text, state.Text))
+	}
+	// A conflicting full-text replay cannot retract bytes already streamed.
+	// Retain the observed text consistently instead of giving GET a different
+	// result. The native journal remains available for diagnosis through RDCA.
+}
+
+func (p *uhpProjection) reasoning(key string) *uhpProjectedItem {
+	return p.add(key, "reasoning", "rs_", map[string]any{"summary": []any{}})
+}
+
+func (p *uhpProjection) summaryPart(state *uhpProjectedItem, index int) {
+	if state.Done || index < 0 || index > 1024 {
+		return
+	}
+	for len(state.Summary) <= index {
+		at := len(state.Summary)
+		state.Summary = append(state.Summary, "")
+		part := map[string]any{"type": "summary_text", "text": ""}
+		item := p.Response.Output[state.Index]
+		item["summary"] = append(uhpArray(item["summary"]), part)
+		fields := p.fields(state)
+		fields["summary_index"], fields["part"] = at, part
+		p.emit("response.reasoning_summary_part.added", fields)
+	}
+}
+
+func (p *uhpProjection) summaryDelta(state *uhpProjectedItem, index int, delta string) {
+	p.summaryPart(state, index)
+	if state.Done || index < 0 || index >= len(state.Summary) || delta == "" {
+		return
+	}
+	state.Summary[index] += delta
+	uhpMap(uhpArray(p.Response.Output[state.Index]["summary"])[index])["text"] = state.Summary[index]
+	fields := p.fields(state)
+	fields["summary_index"], fields["delta"] = index, delta
+	p.emit("response.reasoning_summary_text.delta", fields)
+}
+
+func (p *uhpProjection) tool(key, name, arguments string) *uhpProjectedItem {
+	if state := p.Items[key]; state != nil {
+		if name != "" {
+			p.Response.Output[state.Index]["name"] = name
+		}
+		return state
+	}
+	state := p.add(key, "function_call", "fc_", map[string]any{"name": name, "call_id": p.itemID("call_", key), "arguments": ""})
+	p.ToolCalls++
+	p.completeArguments(state, arguments)
+	return state
+}
+
+func (p *uhpProjection) completeArguments(state *uhpProjectedItem, arguments string) {
+	if state.Done || arguments == "" || !strings.HasPrefix(arguments, state.Arguments) {
+		return
+	}
+	delta := strings.TrimPrefix(arguments, state.Arguments)
+	state.Arguments = arguments
+	p.Response.Output[state.Index]["arguments"] = arguments
+	if delta != "" {
+		fields := p.fields(state)
+		fields["delta"] = delta
+		p.emit("response.function_call_arguments.delta", fields)
+	}
+}
+
+func (p *uhpProjection) toolResult(key, output string) {
+	resultKey := key + ":result"
+	if p.Items[resultKey] != nil {
+		return
+	}
+	state := p.add(resultKey, "function_call_output", "fco_", map[string]any{"call_id": p.itemID("call_", key), "output": output})
+	p.closeItem(state, "completed")
+}
+
+func (p *uhpProjection) closeItem(state *uhpProjectedItem, status string) {
+	if state.Done {
+		return
+	}
+	item := p.Response.Output[state.Index]
+	item["status"] = status
+	switch state.Kind {
+	case "message":
+		fields := p.fields(state)
+		fields["content_index"], fields["text"] = 0, state.Text
+		p.emit("response.output_text.done", fields)
+		fields = p.fields(state)
+		fields["content_index"], fields["part"] = 0, uhpArray(item["content"])[0]
+		p.emit("response.content_part.done", fields)
+	case "reasoning":
+		for index, part := range uhpArray(item["summary"]) {
+			fields := p.fields(state)
+			fields["summary_index"], fields["part"] = index, part
+			p.emit("response.reasoning_summary_part.done", fields)
+		}
+	case "function_call":
+		fields := p.fields(state)
+		fields["arguments"] = state.Arguments
+		p.emit("response.function_call_arguments.done", fields)
+	}
+	state.Done = true
+	p.emit("response.output_item.done", map[string]any{"output_index": state.Index, "item": item})
+}
+
+// AddAnnotations is called before Finish after the resource service has found
+// artifacts. Message completion is delayed until Finish, so annotations never
+// arrive after output_item.done for the item they refer to.
+func (p *uhpProjection) AddAnnotations(annotations []map[string]any) {
+	if p.Response.Status != "in_progress" || len(annotations) == 0 {
+		return
+	}
+	var state *uhpProjectedItem
+	for _, candidate := range p.Items {
+		if candidate.Kind == "message" && !candidate.Done && (state == nil || candidate.Index > state.Index) {
+			state = candidate
+		}
+	}
+	if state == nil {
+		state = p.message("artifacts")
+		state.NativeDone = true
+	}
+	part := uhpMap(uhpArray(p.Response.Output[state.Index]["content"])[0])
+	existing := uhpArray(part["annotations"])
+	for _, annotation := range annotations {
+		encoded := uhpJSON(annotation)
+		duplicate := false
+		for _, old := range existing {
+			if uhpJSON(old) == encoded {
+				duplicate = true
+				break
+			}
+		}
+		if duplicate {
+			continue
+		}
+		fields := p.fields(state)
+		fields["content_index"], fields["annotation_index"], fields["annotation"] = 0, len(existing), annotation
+		p.emit("response.output_text.annotation.added", fields)
+		existing = append(existing, annotation)
+	}
+	part["annotations"] = existing
+}
+
+func (p *uhpProjection) Finish(status string, err *uhpError) {
+	if p.Response.Status != "in_progress" {
+		return
+	}
+	if status != "completed" && status != "failed" && status != "cancelled" && status != "incomplete" {
+		status = "failed"
+	}
+	// Close in output order, not Go map order: replay must yield the same wire
+	// sequence after any restart or polling interval.
+	byIndex := make([]*uhpProjectedItem, len(p.Response.Output))
+	for _, state := range p.Items {
+		byIndex[state.Index] = state
+	}
+	for _, state := range byIndex {
+		if state != nil {
+			itemStatus := "incomplete"
+			if state.NativeDone || state.Done || status == "completed" {
+				itemStatus = "completed"
+			}
+			p.closeItem(state, itemStatus)
+		}
+	}
+	p.Response.Status = status
+	if status == "failed" {
+		if err == nil {
+			err = &uhpError{Type: "harness_error", Code: "harness_error", Message: "The harness could not complete the task."}
+		}
+		p.Response.Error = err
+	} else {
+		p.Response.Error = nil
+	}
+	kind := "response." + status
+	if status == "cancelled" {
+		kind = "response.failed"
+	}
+	p.emit(kind, map[string]any{"response": p.Response})
+	p.PendingNative = nil
+}
+
+func uhpCodexTool(item map[string]any) (name, arguments, output string, supported bool) {
+	supported = true
+	switch uhpString(item["type"]) {
+	case "commandExecution":
+		name = "exec_command"
+		if item["command"] != nil {
+			arguments = uhpJSON(map[string]any{"command": item["command"]})
+		}
+		output = uhpString(item["aggregatedOutput"])
+	case "mcpToolCall":
+		name = uhpString(item["server"]) + "." + uhpString(item["tool"])
+		arguments = uhpKnownJSON(item["arguments"])
+		output = uhpJSON(item["result"])
+		if item["error"] != nil {
+			output = uhpJSON(map[string]any{"error": item["error"], "result": item["result"]})
+		}
+	case "dynamicToolCall":
+		name = uhpString(item["tool"])
+		arguments = uhpKnownJSON(item["arguments"])
+		output = uhpJSON(item["contentItems"])
+	case "fileChange":
+		name, arguments, output = "apply_patch", uhpKnownJSON(item["changes"]), uhpString(item["status"])
+	case "webSearch":
+		name, arguments, output = "web_search", uhpJSON(map[string]any{"query": item["query"]}), uhpJSON(item["action"])
+	case "collabAgentToolCall":
+		name = uhpString(item["tool"])
+		arguments = uhpJSON(map[string]any{"prompt": item["prompt"], "receiver_thread_ids": item["receiverThreadIds"]})
+		output = uhpJSON(item["agentsStates"])
+	default:
+		supported = false
+	}
+	return
+}
+
+func uhpMap(v any) map[string]any {
+	m, _ := v.(map[string]any)
+	return m
+}
+
+func uhpArray(v any) []any {
+	if values, ok := v.([]any); ok {
+		return values
+	}
+	if values, ok := v.([]map[string]any); ok {
+		out := make([]any, len(values))
+		for index, item := range values {
+			out[index] = item
+		}
+		return out
+	}
+	return nil
+}
+
+func uhpString(v any) string { s, _ := v.(string); return s }
+func uhpInt(v any) int       { n, _ := v.(float64); return int(n) }
+func uhpJSON(v any) string   { b, _ := json.Marshal(v); return string(b) }
+
+func uhpKnownJSON(v any) string {
+	if v == nil {
+		return ""
+	}
+	return uhpJSON(v)
+}
