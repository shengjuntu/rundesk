+package app
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+// This is a separate task service, not a Manager wrapper. It verifies that the
+// transport can depend on the lifecycle contract without owning native engines.
+type taskControlFixture struct {
+	input    TaskSpec
+	canceled string
+}
+
+func (f *taskControlFixture) Enqueue(in TaskSpec) (Task, error) {
+	f.input = in
+	return Task{ID: "task-contract", Status: "queued"}, nil
+}
+func (f *taskControlFixture) Task(id string) (Task, error) {
+	return Task{ID: id, Status: "queued"}, nil
+}
+func (f *taskControlFixture) Tasks() []Task {
+	return []Task{{ID: "task-contract", Status: "queued"}}
+}
+func (f *taskControlFixture) CancelTask(id string) (Task, error) {
+	f.canceled = id
+	return Task{ID: id, Status: "canceled"}, nil
+}
+
+func TestTaskRoutesUseLifecycleContract(t *testing.T) {
+	f := &taskControlFixture{}
+	s := &Server{Tasks: f}
+	mux := http.NewServeMux()
+	s.queueRoutes(mux)
+	for _, req := range []struct {
+		method, path, body string
+		status             int
+	}{
+		{"POST", "/api/tasks", `{"workspaceId":"project","input":{"text":"run"}}`, 202},
+		{"GET", "/api/tasks/task-contract", "", 200},
+		{"GET", "/api/tasks", "", 200},
+		{"POST", "/api/tasks/task-contract/cancel", "", 200},
+	} {
+		w := httptest.NewRecorder()
+		r := httptest.NewRequest(req.method, req.path, strings.NewReader(req.body))
+		mux.ServeHTTP(w, r)
+		if w.Code != req.status {
+			t.Fatalf("%s: %d %s", req.path, w.Code, w.Body.String())
+		}
+	}
+	if f.input.WorkspaceID != "project" || f.input.Input.Text != "run" || f.canceled != "task-contract" {
+		t.Fatalf("transport did not use injected task control: %+v", f)
+	}
+}
diff --git a/internal/app/task_submission.go b/internal/app/task_submission.go
new file mode 100644
index 0000000..f9faa35
--- /dev/null
+++ b/internal/app/task_submission.go
@@ -0,0 +1,184 @@
+package app
+
+import (
+	"strings"
+	"time"
+
+	"github.com/shengjuntu/rundesk/internal/store"
+)
+
+// SubmitTask shares admission, authorization, queueing and persistence across
+// protocol facades. In particular a retry receipt cannot be committed without
+// its task, nor can the task be dispatched before the receipt is durable.
+func (m *Manager) SubmitTask(sub TaskSubmission) (Task, error) {
+	var t Task
+	var s Session
+	var err error
+	if sub.SessionID == "" {
+		if sub.ExpectedRunID != "" {
+			return t, failure(400, "invalid_task", "新会话不能指定先前运行")
+		}
+		t, s, err = m.prepareTask(sub.Spec, true)
+	} else {
+		// Use the same session operation lock as manual starts, edits and deletion.
+		// Wait for terminal-process cleanup, but reject a running or reserved turn
+		// promptly instead of waiting behind native execution.
+		if _, err = m.Session(sub.SessionID); err != nil {
+			return t, err
+		}
+		h, e := m.getHandle(sub.SessionID)
+		if e != nil {
+			return t, e
+		}
+		if err = m.lockTaskContinuation(sub.SessionID, h); err != nil {
+			return t, err
+		}
+		defer h.op.Unlock()
+		h.admission.Lock()
+		defer h.admission.Unlock()
+		t, s, err = m.prepareContinuedTask(sub)
+	}
+	if err != nil {
+		return t, err
+	}
+	// Match start's ordering: session operation -> application -> queue -> key.
+	// Preparation (which may inspect runtime configuration) happens before these
+	// global locks, while final authority is rechecked immediately before commit.
+	m.applicationMu.Lock()
+	defer m.applicationMu.Unlock()
+	m.queueMu.Lock()
+	defer m.queueMu.Unlock()
+	m.keyMu.Lock()
+	defer m.keyMu.Unlock()
+	if m.ctx.Err() != nil {
+		return t, failure(503, "runtime_unavailable", "后台正在停止")
+	}
+	if err = m.checkTaskAuthorization(t.SubmittingKeyID, t.Spec, false); err != nil {
+		return t, err
+	}
+	if sub.SessionID != "" {
+		for _, previous := range m.tasks {
+			if previous.SessionID != s.ID {
+				continue
+			}
+			// Freeze the original run's result before a new turn can change it.
+			if err = m.reconcileTaskLocked(previous); err != nil {
+				return t, err
+			}
+			if taskPending(m.tasks[previous.ID].Status) {
+				return t, failure(409, "session_busy", "该会话已有运行或排队任务")
+			}
+		}
+	}
+	if m.pendingCountLocked() >= 1000 {
+		return t, failure(429, "queue_full", "待处理任务最多 1000 项")
+	}
+	records := []store.Record{{Kind: "task", ID: t.ID, Value: t}, {Kind: "session", ID: s.ID, Value: s}}
+	if sub.Records != nil {
+		extra, e := sub.Records(t, s)
+		if e != nil {
+			return t, e
+		}
+		seen := map[string]bool{}
+		for _, record := range extra {
+			key := record.Kind + "\x00" + record.ID
+			if record.Kind == "task" || record.Kind == "session" || record.Kind == "" || record.ID == "" || seen[key] {
+				return t, failure(400, "invalid_task_records", "任务附加记录无效或重复")
+			}
+			seen[key] = true
+		}
+		records = append(records, extra...)
+	}
+	if err = m.Store.PutMany(records...); err != nil {
+		return t, err
+	}
+	m.tasks[t.ID] = t
+	m.mu.Lock()
+	m.sessions[s.ID] = &s
+	m.mu.Unlock()
+	return t, nil
+}
+
+func (m *Manager) lockTaskContinuation(id string, h *handle) error {
+	if h.op.TryLock() {
+		return nil
+	}
+	tick := time.NewTicker(5 * time.Millisecond)
+	defer tick.Stop()
+	for {
+		s, err := m.Session(id)
+		if err != nil {
+			return err
+		}
+		if active(s.Status) || m.queueReserved(id) {
+			return failure(409, "session_busy", "该会话已有运行或排队任务")
+		}
+		select {
+		case <-m.ctx.Done():
+			return failure(503, "runtime_unavailable", "后台正在停止")
+		case <-tick.C:
+			if h.op.TryLock() {
+				return nil
+			}
+		}
+	}
+}
+
+// Caller holds the session operation/admission locks, keeping native identity
+// and the working directory unchanged through final admission.
+func (m *Manager) prepareContinuedTask(sub TaskSubmission) (Task, Session, error) {
+	s, err := m.Session(sub.SessionID)
+	if err != nil {
+		return Task{}, s, err
+	}
+	if active(s.Status) {
+		return Task{}, s, failure(409, "session_busy", "该会话已有任务正在运行")
+	}
+	if s.Archived {
+		return Task{}, s, failure(409, "session_archived", "请先恢复已归档会话，再提交任务")
+	}
+	if sub.ExpectedRunID != "" && s.RunID != sub.ExpectedRunID {
+		return Task{}, s, failure(409, "run_conflict", "会话已切换到其他任务")
+	}
+	spec := sub.Spec
+	if (spec.WorkspaceID != "" && spec.WorkspaceID != s.WorkspaceID) || (spec.InstanceID != "" && spec.InstanceID != s.InstanceID) || (spec.Source != (SessionSource{}) && spec.Source != s.Source) {
+		return Task{}, s, failure(409, "session_mismatch", "续接必须沿用会话的项目、实例和来源")
+	}
+	if strings.TrimSpace(spec.Input.Text) == "" || len(spec.Input.Text) > 256*1024 {
+		return Task{}, s, failure(400, "invalid_input", "任务消息需为 1–256 KiB")
+	}
+	if len([]rune(spec.Title)) > 120 {
+		return Task{}, s, failure(400, "invalid_task", "标题最多 120 字符")
+	}
+	if spec.NotBefore != "" {
+		at, e := time.Parse(time.RFC3339Nano, spec.NotBefore)
+		if e != nil {
+			return Task{}, s, failure(400, "invalid_not_before", "notBefore 需要 RFC3339 时间")
+		}
+		spec.NotBefore = at.UTC().Format(time.RFC3339Nano)
+	}
+	if err = m.checkSessionExecution(s); err != nil {
+		return Task{}, s, err
+	}
+	w, err := m.Workspace(s.WorkspaceID)
+	if err != nil {
+		return Task{}, s, err
+	}
+	if err = m.validateSessionInput(s, w, spec.Input); err != nil {
+		return Task{}, s, err
+	}
+	// A model override applies to this new turn; it does not create a new native
+	// thread. The facade validates model availability before submission.
+	if spec.Model != "" {
+		s.Model = spec.Model
+	}
+	spec.WorkspaceID, spec.InstanceID = s.WorkspaceID, s.InstanceID
+	spec.Model, spec.Source = s.Model, s.Source
+	if spec.Title == "" {
+		spec.Title = s.Title
+	}
+	t := Task{SubmittingKeyID: spec.SubmittingKeyID, FileOwner: spec.Input.LibraryOwner, ID: store.ID(), SessionID: s.ID, Spec: spec, Status: "queued", Created: store.Now(), Updated: store.Now()}
+	s.TaskID = t.ID
+	s.Updated = t.Updated
+	return t, s, nil
+}
diff --git a/internal/app/task_submission_test.go b/internal/app/task_submission_test.go
new file mode 100644
index 0000000..8fc83ed
--- /dev/null
+++ b/internal/app/task_submission_test.go
@@ -0,0 +1,215 @@
+package app
+
+import (
+	"database/sql"
+	"encoding/json"
+	"errors"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/shengjuntu/rundesk/internal/store"
+)
+
+func pauseSubmissionQueue(t *testing.T, m *Manager) {
+	t.Helper()
+	q := m.Queue()
+	q.Paused = true
+	if _, err := m.SaveQueue(q); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestTaskSubmissionBindsRecordsAtomically(t *testing.T) {
+	m := testManager(t)
+	pauseSubmissionQueue(t, m)
+	spec := TaskSpec{WorkspaceID: m.Workspaces()[0].ID, Input: Input{Text: "bound task"}}
+	var taskID, sessionID string
+	_, err := m.SubmitTask(TaskSubmission{Spec: spec, Records: func(task Task, session Session) ([]store.Record, error) {
+		taskID, sessionID = task.ID, session.ID
+		return []store.Record{{Kind: "test-receipt", ID: "failed", Value: make(chan int)}}, nil
+	}})
+	if err == nil {
+		t.Fatal("unserializable metadata accepted")
+	}
+	if _, err = m.Task(taskID); err == nil {
+		t.Fatal("failed transaction admitted task")
+	}
+	if _, err = m.Session(sessionID); err == nil {
+		t.Fatal("failed transaction cached session")
+	}
+	for _, object := range []struct{ kind, id string }{{"task", taskID}, {"session", sessionID}, {"test-receipt", "failed"}} {
+		var value any
+		if err = m.Store.Get(object.kind, object.id, &value); !errors.Is(err, sql.ErrNoRows) {
+			t.Fatalf("partial transaction %s: %v", object.kind, err)
+		}
+	}
+	task, err := m.SubmitTask(TaskSubmission{Spec: spec, Records: func(task Task, session Session) ([]store.Record, error) {
+		return []store.Record{{Kind: "test-receipt", ID: "accepted", Value: map[string]string{"taskId": task.ID, "sessionId": session.ID}}}, nil
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var receipt map[string]string
+	if err = m.Store.Get("test-receipt", "accepted", &receipt); err != nil || receipt["taskId"] != task.ID || receipt["sessionId"] != task.SessionID {
+		t.Fatalf("receipt did not bind to admitted task: %#v %v", receipt, err)
+	}
+}
+
+func TestTaskSubmissionCannotReplaceCoreRecords(t *testing.T) {
+	m := testManager(t)
+	pauseSubmissionQueue(t, m)
+	for _, kind := range []string{"task", "session"} {
+		_, err := m.SubmitTask(TaskSubmission{Spec: TaskSpec{WorkspaceID: m.Workspaces()[0].ID, Input: Input{Text: "invalid binding"}}, Records: func(task Task, session Session) ([]store.Record, error) {
+			return []store.Record{{Kind: kind, ID: task.ID, Value: "corrupt"}}, nil
+		}})
+		if err == nil {
+			t.Fatalf("accepted replacement for %s", kind)
+		}
+	}
+	if len(m.Tasks()) != 0 {
+		t.Fatal("invalid binding created tasks")
+	}
+}
+
+func TestTaskContinuationPreservesNativeSessionAndOldTask(t *testing.T) {
+	m := testManager(t)
+	first, err := m.Enqueue(TaskSpec{WorkspaceID: m.Workspaces()[0].ID, Input: Input{Text: "first turn"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	first = taskWait(t, m, first.ID, "completed")
+	before, err := m.Session(first.SessionID)
+	if err != nil || before.ThreadID == "" {
+		t.Fatal(before, err)
+	}
+	second, err := m.SubmitTask(TaskSubmission{SessionID: before.ID, ExpectedRunID: first.RunID, Spec: TaskSpec{Model: "continued-model", Input: Input{Text: "continue turn"}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	second = taskWait(t, m, second.ID, "completed")
+	after, _ := m.Session(before.ID)
+	if second.ID == first.ID || second.SessionID != first.SessionID || second.RunID == first.RunID || after.ThreadID != before.ThreadID || after.WorkspaceID != before.WorkspaceID || after.TaskID != second.ID {
+		t.Fatalf("continuation lost identity: first=%+v second=%+v before=%+v after=%+v", first, second, before, after)
+	}
+	retained, _ := m.Task(first.ID)
+	if retained.Status != "completed" || retained.RunID != first.RunID || retained.FinishedAt != first.FinishedAt {
+		t.Fatal("continuation changed original task", retained)
+	}
+	if after.Model != "continued-model" || second.Spec.Model != "continued-model" || retained.Spec.Model != first.Spec.Model {
+		t.Fatal("model override was not scoped to new turn")
+	}
+	event, err := m.Store.LatestEvent(after.ID, "turn/start")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var envelope struct {
+		Params struct {
+			Model string `json:"model"`
+		} `json:"params"`
+	}
+	if err = json.Unmarshal(event.Data, &envelope); err != nil || envelope.Params.Model != "continued-model" {
+		t.Fatalf("native turn did not select continued model: %s %v", event.Data, err)
+	}
+	if _, err = m.SubmitTask(TaskSubmission{SessionID: after.ID, ExpectedRunID: first.RunID, Spec: TaskSpec{Input: Input{Text: "stale parent"}}}); err == nil {
+		t.Fatal("stale parent accepted")
+	}
+}
+
+func TestConcurrentTaskContinuationsReserveOneSession(t *testing.T) {
+	m := testManager(t)
+	pauseSubmissionQueue(t, m)
+	s, err := m.CreateSession(m.Workspaces()[0].ID, "shared session", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var wg sync.WaitGroup
+	results := make(chan error, 12)
+	for n := 0; n < cap(results); n++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			_, err := m.SubmitTask(TaskSubmission{SessionID: s.ID, Spec: TaskSpec{Input: Input{Text: "one continuation"}}})
+			results <- err
+		}()
+	}
+	wg.Wait()
+	close(results)
+	accepted := 0
+	for err := range results {
+		if err == nil {
+			accepted++
+			continue
+		}
+		var api *apiError
+		if !errors.As(err, &api) || api.Code != "session_busy" {
+			t.Fatal(err)
+		}
+	}
+	if accepted != 1 || len(m.Tasks()) != 1 {
+		t.Fatalf("accepted %d continuations; tasks %d", accepted, len(m.Tasks()))
+	}
+	if _, err = m.Start(s.ID, Input{Text: "manual bypass"}); err == nil {
+		t.Fatal("manual start bypassed continuation reservation")
+	}
+}
+
+func TestTaskContinuationRejectsActiveSessionPromptly(t *testing.T) {
+	m := testManager(t)
+	task, err := m.Enqueue(TaskSpec{WorkspaceID: m.Workspaces()[0].ID, Input: Input{Text: "审批"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	taskWait(t, m, task.ID, "waiting")
+	defer m.CancelTask(task.ID)
+	done := make(chan error, 1)
+	go func() {
+		_, err := m.SubmitTask(TaskSubmission{SessionID: task.SessionID, Spec: TaskSpec{Input: Input{Text: "must not wait for approval"}}})
+		done <- err
+	}()
+	select {
+	case err := <-done:
+		var api *apiError
+		if !errors.As(err, &api) || api.Code != "session_busy" {
+			t.Fatalf("expected busy, got %v", err)
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("continuation blocked behind active native execution")
+	}
+}
+
+func TestTaskContinuationRechecksCredentialBeforeCommitAndDispatch(t *testing.T) {
+	m := testManager(t)
+	pauseSubmissionQueue(t, m)
+	wid := m.Workspaces()[0].ID
+	app, key, _ := setupKey(t, m, "continuation-auth", wid, "read", "run")
+	source := SessionSource{Kind: "application", AppID: app.AppID}
+	s, err := m.CreateSessionWithSource(wid, "protected", "", app.InstanceID, source)
+	if err != nil {
+		t.Fatal(err)
+	}
+	sub := TaskSubmission{SessionID: s.ID, Spec: TaskSpec{SubmittingKeyID: key.ID, Input: Input{Text: "protected continuation"}}}
+	task, err := m.SubmitTask(sub)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = m.RevokeApplicationKey(app.AppID, key.ID); err != nil {
+		t.Fatal(err)
+	}
+	q := m.Queue()
+	q.Paused = false
+	if _, err = m.SaveQueue(q); err != nil {
+		t.Fatal(err)
+	}
+	m.queueTick()
+	failed := taskWait(t, m, task.ID, "failed")
+	if failed.RunID != "" {
+		t.Fatal("revoked queued continuation executed")
+	}
+	if _, err = m.SubmitTask(sub); err == nil {
+		t.Fatal("revoked credential admitted a new continuation")
+	}
+	if len(m.Tasks()) != 1 {
+		t.Fatal("unauthorized admission persisted task")
+	}
+}
diff --git a/internal/app/task_view.go b/internal/app/task_view.go
new file mode 100644
index 0000000..518863a
--- /dev/null
+++ b/internal/app/task_view.go
@@ -0,0 +1,180 @@
+package app
+
+import (
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/shengjuntu/rundesk/internal/resource"
+	"github.com/shengjuntu/rundesk/internal/store"
+)
+
+// TaskResourceView is a point-in-time projection of platform state and resource
+// references. Configuration is the current binding, not a claim that a past run
+// executed with today's instance settings. Original bytes stay with their owner.
+type TaskResourceView struct {
+	Schema             int               `json:"schema"`
+	ObservedAt         string            `json:"observedAt"`
+	StateSource        string            `json:"stateSource"`
+	Availability       string            `json:"availability"`
+	UnavailableReason  string            `json:"unavailableReason,omitempty"`
+	ConfigurationBasis string            `json:"configurationBasis"`
+	Task               TaskStateView     `json:"task"`
+	Runtime            *TaskRuntimeView  `json:"runtime,omitempty"`
+	Resources          resource.Manifest `json:"resources"`
+}
+
+type TaskStateView struct {
+	ID              string `json:"id"`
+	SessionID       string `json:"sessionId"`
+	RunID           string `json:"runId,omitempty"`
+	Status          string `json:"status"`
+	CancelRequested bool   `json:"cancelRequested"`
+	Created         string `json:"created"`
+	Updated         string `json:"updated"`
+	StartedAt       string `json:"startedAt,omitempty"`
+	FinishedAt      string `json:"finishedAt,omitempty"`
+}
+
+type TaskRuntimeView struct {
+	Kind              string `json:"kind"`
+	ExecutionMode     string `json:"executionMode"`
+	EnvironmentID     string `json:"environmentId,omitempty"`
+	SessionID         string `json:"sessionId"`
+	RunID             string `json:"runId,omitempty"`
+	ThreadID          string `json:"threadId,omitempty"`
+	TurnID            string `json:"turnId,omitempty"`
+	NativeAssociation string `json:"nativeAssociation"`
+}
+
+type TaskResourceExport struct {
+	TaskID     string `json:"taskId"`
+	ObservedAt string `json:"observedAt"`
+	Path       string `json:"path"`
+}
+
+func (m *Manager) TaskResources(id string) (TaskResourceView, error) {
+	var view TaskResourceView
+	// Match queue -> session lock ordering used by admission/reconciliation.
+	// Do not reconcile or submit work as a side effect of inspecting a task.
+	m.queueMu.Lock()
+	t, ok := m.tasks[id]
+	if !ok {
+		m.queueMu.Unlock()
+		return view, failure(404, "task_not_found", "任务不存在")
+	}
+	s, err := m.Session(t.SessionID)
+	m.queueMu.Unlock()
+	view = TaskResourceView{
+		Schema: 1, ObservedAt: store.Now(), StateSource: "platform_sqlite",
+		Availability: "available", ConfigurationBasis: "current_bindings",
+		Task: TaskStateView{
+			ID: t.ID, SessionID: t.SessionID, RunID: t.RunID, Status: t.Status,
+			CancelRequested: t.CancelRequested, Created: t.Created, Updated: t.Updated,
+			StartedAt: t.StartedAt, FinishedAt: t.FinishedAt,
+		},
+		Resources: resource.Manifest{
+			Schema: 1,
+			Scope: resource.Scope{InstanceID: t.Spec.InstanceID, WorkspaceID: t.Spec.WorkspaceID,
+				SessionID: t.SessionID, TaskID: t.ID},
+			Resources: []resource.Descriptor{}, Bindings: []resource.Binding{},
+		},
+	}
+	if err != nil {
+		var unavailable *apiError
+		if errors.As(err, &unavailable) && unavailable.Code == "session_not_found" {
+			// Deleting a terminal session does not delete the task record or
+			// original files. Preserve the known task facts, without recreating
+			// a session or inferring native identity from today's instance.
+			view.Availability, view.UnavailableReason = "unavailable", "session_not_found"
+			view.ConfigurationBasis = "unavailable"
+			return view, nil
+		}
+		return TaskResourceView{}, err
+	}
+	manifest, err := m.SessionResources(s)
+	if err != nil {
+		return TaskResourceView{}, err
+	}
+	view.Resources = manifest
+	view.Runtime = &TaskRuntimeView{
+		Kind: runtimeKind(s.RuntimeKind), ExecutionMode: s.ExecutionMode,
+		EnvironmentID: s.EnvironmentID, SessionID: s.ID, RunID: t.RunID,
+		NativeAssociation: "not_started",
+	}
+	if t.RunID != "" {
+		view.Runtime.NativeAssociation = "unavailable"
+		// A session can later be continued manually. Never attribute that newer
+		// turn/thread to the task's historical run.
+		if s.RunID == t.RunID {
+			view.Runtime.NativeAssociation = "current_run"
+			view.Runtime.ThreadID, view.Runtime.TurnID = s.ThreadID, s.TurnID
+		}
+	}
+	return view, nil
+}
+
+// ExportTaskResources refreshes one atomic JSON view. Deleting or editing this
+// file cannot change the task; a subsequent refresh reconstructs it from the
+// platform records. The API caller must be an administrator.
+func (m *Manager) ExportTaskResources(id string) (TaskResourceExport, error) {
+	var result TaskResourceExport
+	view, err := m.TaskResources(id)
+	if err != nil {
+		return result, err
+	}
+	if id == "" || id == "." || id == ".." || strings.ContainsAny(id, "/\\\x00:") {
+		return result, failure(400, "invalid_task_id", "任务编号不能用于目录视图")
+	}
+	data, err := json.MarshalIndent(view, "", "  ")
+	if err != nil {
+		return result, err
+	}
+	data = append(data, '\n')
+	root, err := os.OpenRoot(m.Data)
+	if err != nil {
+		return result, err
+	}
+	defer root.Close()
+	dir := filepath.Join("tasks", id)
+	// A task directory is host metadata, never a symlink into native state or
+	// the workspace. OpenRoot also confines every subsequent write to Data.
+	for _, path := range []string{"tasks", dir} {
+		info, e := root.Lstat(path)
+		if os.IsNotExist(e) {
+			if e = root.Mkdir(path, 0700); e != nil && !os.IsExist(e) {
+				return result, e
+			}
+			info, e = root.Lstat(path)
+		}
+		if e != nil {
+			return result, e
+		}
+		if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+			return result, failure(409, "task_view_path_invalid", "任务视图目录必须为普通目录")
+		}
+	}
+	tmp := filepath.Join(dir, ".resources-"+store.ID()+".tmp")
+	f, err := root.OpenFile(tmp, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
+	if err != nil {
+		return result, err
+	}
+	defer root.Remove(tmp)
+	if _, err = f.Write(data); err == nil {
+		err = f.Sync()
+	}
+	closeErr := f.Close()
+	if err == nil {
+		err = closeErr
+	}
+	if err != nil {
+		return result, err
+	}
+	dest := filepath.Join(dir, "resources.json")
+	if err = root.Rename(tmp, dest); err != nil {
+		return result, err
+	}
+	return TaskResourceExport{TaskID: id, ObservedAt: view.ObservedAt, Path: filepath.Join(m.Data, dest)}, nil
+}
