+	call := map[string]any{"id": "tool", "function": map[string]any{"name": "read_file", "arguments": `{"path":"a.txt"}`}}
+	apply(3, "run", "kun/tool.started", map[string]any{"call": call})
+	apply(4, "run", "kun/tool.completed", map[string]any{"call": call, "output": "file contents"})
+	apply(5, "run", "kun/model.completed", map[string]any{"step": 2, "usage": map[string]any{"total_tokens": 6}, "message": map[string]any{"content": "answer"}})
+	p.Finish("completed", nil)
+	if p.Steps != 2 || len(p.Response.Output) != 3 || strings.Contains(uhpJSON(p), "FOREIGN") || strings.Contains(uhpJSON(p), "PRIVATE PLAN") {
+		t.Fatalf("Kun filtering/steps: %s", uhpJSON(p))
+	}
+	if uhpJSON(p.Response.Usage) != `{"total_tokens":10}` {
+		t.Fatalf("usage must omit counters missing from any call: %s", uhpJSON(p.Response.Usage))
+	}
+	uhpAssertProjectionSequence(t, p)
+}
+
+func TestUHPProjectionMissingUsageIsNotZero(t *testing.T) {
+	p := uhpProjectionFixture()
+	p.Apply(uhpProjectionEvent(1, "in", "kun/model.completed", map[string]any{"runId": "run", "sequence": 1, "data": map[string]any{"message": map[string]any{"content": "one"}, "usage": map[string]any{"total_tokens": 7}}}), "run")
+	p.Apply(uhpProjectionEvent(2, "in", "kun/model.completed", map[string]any{"runId": "run", "sequence": 2, "data": map[string]any{"message": map[string]any{"content": "two"}}}), "run")
+	p.Finish("incomplete", nil)
+	if p.Response.Usage != nil || p.Response.Error != nil {
+		t.Fatal("missing native usage was converted into a partial total or fake zero")
+	}
+	uhpAssertProjectionSequence(t, p)
+}
+
+func uhpAssertProjectionSequence(t *testing.T, p uhpProjection) {
+	t.Helper()
+	terminal := 0
+	added, done := map[string]bool{}, map[string]bool{}
+	for index, event := range p.Events {
+		if uhpJSON(event["sequence_number"]) != uhpJSON(index) {
+			t.Fatalf("sequence gap at %d: %v", index, event["sequence_number"])
+		}
+		kind := uhpString(event["type"])
+		if index == 0 && kind != "response.created" {
+			t.Fatal("first event is not response.created")
+		}
+		id := uhpString(event["item_id"])
+		if kind == "response.output_item.added" {
+			id = uhpString(uhpMap(event["item"])["id"])
+			if added[id] {
+				t.Fatalf("duplicate added item %s", id)
+			}
+			added[id] = true
+		} else if kind == "response.output_item.done" {
+			id = uhpString(uhpMap(event["item"])["id"])
+			if !added[id] || done[id] {
+				t.Fatalf("item done without one preceding added: %s", id)
+			}
+			done[id] = true
+		} else if id != "" && (!added[id] || done[id]) {
+			t.Fatalf("event outside item lifetime: %s %s", kind, id)
+		}
+		if kind == "response.completed" || kind == "response.failed" || kind == "response.incomplete" {
+			terminal++
+			var expected map[string]any
+			encoded, _ := json.Marshal(p.Response)
+			_ = json.Unmarshal(encoded, &expected)
+			if index != len(p.Events)-1 || uhpJSON(event["response"]) != uhpJSON(expected) {
+				t.Fatal("terminal snapshot differs from response readback")
+			}
+		}
+	}
+	if terminal != 1 || len(added) != len(done) {
+		t.Fatalf("terminal/item counts: terminal=%d added=%d done=%d", terminal, len(added), len(done))
+	}
+}
diff --git a/internal/app/uhp_refresh_test.go b/internal/app/uhp_refresh_test.go
new file mode 100644
index 0000000..3dc4161
--- /dev/null
+++ b/internal/app/uhp_refresh_test.go
@@ -0,0 +1,82 @@
+package app
+
+import (
+	"strings"
+	"testing"
+)
+
+// A native interrupt can finish a final item while CancelTask waits for its
+// reply. Model that deterministic ordering without relying on scheduler timing.
+type uhpClosingTaskControl struct {
+	*Manager
+	task        Task
+	closingText string
+	lastEventID int64
+}
+
+func (c *uhpClosingTaskControl) Task(id string) (Task, error) {
+	if id != c.task.ID {
+		return Task{}, failure(404, "task_not_found", "")
+	}
+	return c.task, nil
+}
+
+func (c *uhpClosingTaskControl) CancelTask(id string) (Task, error) {
+	if id != c.task.ID {
+		return Task{}, failure(404, "task_not_found", "")
+	}
+	params := map[string]any{"turnId": "native-turn", "itemId": "native-message", "delta": c.closingText}
+	event, err := c.Store.Add(c.task.SessionID, "in", "item/agentMessage/delta", map[string]any{"params": params})
+	if err != nil {
+		return Task{}, err
+	}
+	c.lastEventID = event.ID
+	c.task.Status = "interrupted"
+	err = c.update(c.task.SessionID, func(s *Session) { s.Status = "interrupted" })
+	return c.task, err
+}
+
+func TestUHPRefreshDrainsNativeOutputAfterSynchronousCancellation(t *testing.T) {
+	m := testManager(t)
+	session, err := m.CreateSession(m.Workspaces()[0].ID, "closing partial output", "demo-fixture")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = m.update(session.ID, func(s *Session) {
+		s.RunID, s.TurnID, s.Status = "native-run", "native-turn", "running"
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = m.Store.Add(session.ID, "internal", "run/input", map[string]any{"runId": "native-run"}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = m.Store.Add(session.ID, "in", "item/agentMessage/delta", map[string]any{"params": map[string]any{"turnId": "native-turn", "itemId": "native-message", "delta": "partial "}}); err != nil {
+		t.Fatal(err)
+	}
+	control := &uhpClosingTaskControl{Manager: m, task: Task{ID: "native-task", SessionID: session.ID, RunID: "native-run", Status: "running"}, closingText: "closing output"}
+	u := uhpService{server: &Server{Manager: m, Tasks: control}}
+	record := uhpRecord{Owner: "administrator", TaskID: control.task.ID, HostSessionID: session.ID, SessionID: "hsessclosing", ContainerID: "cntr_closing", CancelReason: "cancelled", Projection: newUHPProjection(uhpResponse{ID: "resp_closing", Model: "demo-fixture", Store: true, Metadata: map[string]any{"session_id": "hsessclosing"}})}
+	m.uhpMu.Lock()
+	err = u.refresh(&record)
+	m.uhpMu.Unlock()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if record.Projection.Response.Status != "cancelled" || record.Cursor != control.lastEventID {
+		t.Fatalf("finalization missed the post-interrupt event: status=%s cursor=%d last=%d", record.Projection.Response.Status, record.Cursor, control.lastEventID)
+	}
+	var text strings.Builder
+	for _, event := range record.Projection.Events {
+		if event["type"] == "response.output_text.delta" {
+			text.WriteString(uhpString(event["delta"]))
+		}
+	}
+	if text.String() != "partial closing output" {
+		t.Fatalf("cancel discarded native output: %q", text.String())
+	}
+	uhpAssertProjectionSequence(t, record.Projection)
+	retained := uhpTestRecord(t, m, record.Projection.Response.ID)
+	if uhpJSON(retained.Projection.Response) != uhpJSON(record.Projection.Response) {
+		t.Fatal("persisted terminal response differs from final stream snapshot")
+	}
+}
diff --git a/internal/resource/resource.go b/internal/resource/resource.go
new file mode 100644
index 0000000..0ae61b3
--- /dev/null
+++ b/internal/resource/resource.go
@@ -0,0 +1,352 @@
+// Package resource defines RunDesk-owned resource identities and bindings.
+// Descriptors contain no credentials or host locations. A resolver translates a
+// binding into a host location only after the caller has authorized its session.
+package resource
+
+import (
+	"fmt"
+	"os"
+	"path"
+	"path/filepath"
+	"strings"
+)
+
+type Kind string
+
+const (
+	KindWorkspace    Kind = "workspace"
+	KindOutputs      Kind = "outputs"
+	KindRuntimeState Kind = "runtime-state"
+	KindArtifact     Kind = "artifact"
+	KindSkills       Kind = "skills"
+	KindMCP          Kind = "mcp"
+	KindPlugins      Kind = "plugins"
+	KindPolicy       Kind = "policy"
+)
+
+// Storage states who retains the bytes. Reference never implies a backup.
+type Storage string
+
+const (
+	Reference Storage = "reference"
+	Managed   Storage = "managed"
+	Snapshot  Storage = "snapshot"
+)
+
+type Ref struct {
+	Kind    Kind   `json:"kind"`
+	ID      string `json:"id"`
+	Version string `json:"version,omitempty"`
+}
+
+// Scope is binding provenance, not an authenticated principal. HTTP or other
+// entry points must authorize the caller before constructing a session scope.
+type Scope struct {
+	InstanceID  string `json:"instanceId,omitempty"`
+	WorkspaceID string `json:"workspaceId,omitempty"`
+	SessionID   string `json:"sessionId,omitempty"`
+	TaskID      string `json:"taskId,omitempty"`
+}
+
+type Source struct {
+	System string `json:"system"`
+	ID     string `json:"id"`
+}
+
+// FileSource identifies original workspace bytes without exposing a host path.
+type FileSource struct {
+	WorkspaceID string `json:"workspaceId"`
+	Path        string `json:"path"`
+}
+
+type Role string
+
+const (
+	RoleWorkspace      Role = "workspace"
+	RoleOutputs        Role = "outputs"
+	RoleRuntimeState   Role = "runtime-state"
+	RoleProjectSkills  Role = "project-skills"
+	RoleInstanceSkills Role = "instance-skills"
+	RoleMCP            Role = "mcp"
+	RolePlugins        Role = "plugins"
+	RolePolicy         Role = "policy"
+)
+
+type Access string
+
+const (
+	Read  Access = "read"
+	Write Access = "write"
+)
+
+// Configuration describes a declared source, never an inferred loaded inventory.
+// Backend adapters retain their native formats and activation semantics.
+type Configuration struct {
+	Backend      string   `json:"backend"`
+	State        string   `json:"state"` // declared, configured, or unsupported
+	NativeFormat string   `json:"nativeFormat,omitempty"`
+	Names        []string `json:"names,omitempty"`
+}
+
+type Policy struct {
+	Sandbox        string `json:"sandbox"`
+	ApprovalPolicy string `json:"approvalPolicy"`
+	Reviewer       string `json:"reviewer"`
+	NetworkAccess  *bool  `json:"networkAccess,omitempty"`
+}
+
+type Descriptor struct {
+	Ref     Ref     `json:"ref"`
+	Owner   Scope   `json:"owner"`
+	Storage Storage `json:"storage"`
+	Source  Source  `json:"source"`
+	// VersionKind is binding (configuration revision), content (immutable
+	// digest), or live (no pinned version). A binding revision is not a backup.
+	VersionKind   string         `json:"versionKind"`
+	Configuration *Configuration `json:"configuration,omitempty"`
+	Policy        *Policy        `json:"policy,omitempty"`
+}
+
+type Binding struct {
+	Role   Role   `json:"role"`
+	Ref    Ref    `json:"ref"`
+	Access Access `json:"access"`
+}
+
+type Manifest struct {
+	Schema    int          `json:"schema"`
+	Scope     Scope        `json:"scope"`
+	Resources []Descriptor `json:"resources"`
+	Bindings  []Binding    `json:"bindings"`
+}
+
+type Catalog interface {
+	List() []Descriptor
+	Describe(Ref) (Descriptor, error)
+}
+
+type Bindings interface {
+	Binding(Role) (Binding, error)
+}
+
+type Resolver interface {
+	Resolve(Scope, Ref, Access) (Resolved, error)
+}
+
+// Location stays private to the host. RelativePath is a portable slash-separated
+// relative path. Empty means the root itself. It must never be user-controlled.
+type Location struct {
+	Root         string `json:"-"`
+	RelativePath string `json:"-"`
+}
+
+type Record struct {
+	Descriptor Descriptor
+	Binding    Binding
+	Location   *Location `json:"-"`
+}
+
+type Resolved struct {
+	Descriptor   Descriptor `json:"descriptor"`
+	Path         string     `json:"-"`
+	RelativePath string     `json:"-"`
+}
+
+type Error struct {
+	Code    string `json:"code"`
+	Message string `json:"message"`
+}
+
+func (e *Error) Error() string { return e.Code + ": " + e.Message }
+
+func fail(code, message string) error { return &Error{Code: code, Message: message} }
+
+// Set is an immutable, session-bound projection of canonical platform settings.
+// It owns no original files and does not persist another copy of their contents.
+type Set struct {
+	scope   Scope
+	records []Record
+}
+
+func NewSet(scope Scope, records []Record) (*Set, error) {
+	s := &Set{scope: scope}
+	roles, refs := map[Role]bool{}, map[string]bool{}
+	for _, record := range records {
+		r := cloneRecord(record)
+		if r.Descriptor.Ref.Kind == "" || r.Descriptor.Ref.ID == "" || r.Binding.Role == "" || r.Binding.Ref != r.Descriptor.Ref {
+			return nil, fail("resource_invalid", "resource identity and binding must agree")
+		}
+		if r.Binding.Access != Read && r.Binding.Access != Write {
+			return nil, fail("resource_invalid", "unsupported binding access")
+		}
+		if r.Descriptor.Storage != Reference && r.Descriptor.Storage != Managed && r.Descriptor.Storage != Snapshot {
+			return nil, fail("resource_invalid", "unsupported storage ownership")
+		}
+		if !owns(scope, r.Descriptor.Owner) {
+			return nil, fail("resource_scope_mismatch", "resource owner is outside the session binding")
+		}
+		if r.Descriptor.VersionKind != "live" && r.Descriptor.VersionKind != "binding" && r.Descriptor.VersionKind != "content" {
+			return nil, fail("resource_invalid", "version kind must be explicit")
+		}
+		if r.Descriptor.VersionKind != "live" && r.Descriptor.Ref.Version == "" {
+			return nil, fail("resource_invalid", "versioned resources require a version")
+		}
+		key := string(r.Descriptor.Ref.Kind) + "/" + r.Descriptor.Ref.ID
+		if roles[r.Binding.Role] || refs[key] {
+			return nil, fail("resource_duplicate", "resource identities and binding roles must be unique")
+		}
+		roles[r.Binding.Role], refs[key] = true, true
+		if r.Location != nil {
+			if err := validateLocation(*r.Location); err != nil {
+				return nil, err
+			}
+		}
+		s.records = append(s.records, r)
+	}
+	return s, nil
+}
+
+func validateLocation(l Location) error {
+	if !filepath.IsAbs(l.Root) || strings.ContainsRune(l.Root, 0) {
+		return fail("resource_path_invalid", "resource root must be absolute")
+	}
+	if l.RelativePath != "" && (l.RelativePath == "." || !filepath.IsLocal(filepath.FromSlash(l.RelativePath)) || path.Clean(l.RelativePath) != l.RelativePath || strings.ContainsAny(l.RelativePath, "\\:\x00")) {
+		return fail("resource_path_invalid", "resource location must remain inside its root")
+	}
+	return nil
+}
+
+func owns(scope, owner Scope) bool {
+	return (owner.InstanceID == "" || owner.InstanceID == scope.InstanceID) &&
+		(owner.WorkspaceID == "" || owner.WorkspaceID == scope.WorkspaceID) &&
+		(owner.SessionID == "" || owner.SessionID == scope.SessionID) &&
+		(owner.TaskID == "" || owner.TaskID == scope.TaskID)
+}
+
+// Reject stable aliases below an authorized root. The root itself comes from
+// registered metadata and may be a user's chosen native home. This check is not
+// a sandbox or a guarantee against concurrent filesystem mutation: consumers
+// opening user bytes must continue to use os.Root and native sandbox controls.
+func checkLocation(l Location) error {
+	root, err := os.OpenRoot(l.Root)
+	if os.IsNotExist(err) {
+		return nil
+	} // Native runtime may create its state root.
+	if err != nil {
+		return fail("resource_unavailable", "resource root is unavailable")
+	}
+	defer root.Close()
+	if l.RelativePath == "" {
+		return nil
+	}
+	parts := strings.Split(l.RelativePath, "/")
+	for index := range parts {
+		info, err := root.Lstat(filepath.FromSlash(strings.Join(parts[:index+1], "/")))
+		if os.IsNotExist(err) {
+			return nil
+		} // The host may create the remaining path.
+		if err != nil {
+			return fail("resource_unavailable", "resource location is unavailable")
+		}
+		if info.Mode()&os.ModeSymlink != 0 {
+			return fail("resource_path_invalid", "resource location contains a symbolic link")
+		}
+	}
+	return nil
+}
+
+func (s *Set) List() []Descriptor {
+	out := make([]Descriptor, 0, len(s.records))
+	for _, r := range s.records {
+		out = append(out, cloneDescriptor(r.Descriptor))
+	}
+	return out
+}
+
+func (s *Set) Describe(ref Ref) (Descriptor, error) {
+	for _, r := range s.records {
+		if r.Descriptor.Ref.Kind == ref.Kind && r.Descriptor.Ref.ID == ref.ID {
+			if r.Descriptor.Ref.Version != ref.Version {
+				return Descriptor{}, fail("resource_version_changed", "resource binding version has changed")
+			}
+			return cloneDescriptor(r.Descriptor), nil
+		}
+	}
+	return Descriptor{}, fail("resource_not_bound", "resource is not bound to this session")
+}
+
+func (s *Set) Binding(role Role) (Binding, error) {
+	for _, r := range s.records {
+		if r.Binding.Role == role {
+			return r.Binding, nil
+		}
+	}
+	return Binding{}, fail("resource_not_bound", fmt.Sprintf("resource role %q is not bound", role))
+}
+
+func (s *Set) Resolve(scope Scope, ref Ref, access Access) (Resolved, error) {
+	if scope != s.scope {
+		return Resolved{}, fail("resource_scope_mismatch", "resource belongs to another session binding")
+	}
+	if access != Read && access != Write {
+		return Resolved{}, fail("resource_access_invalid", "unsupported resource access")
+	}
+	d, err := s.Describe(ref)
+	if err != nil {
+		return Resolved{}, err
+	}
+	for _, r := range s.records {
+		if r.Descriptor.Ref != ref {
+			continue
+		}
+		if access == Write && r.Binding.Access != Write {
+			return Resolved{}, fail("resource_read_only", "resource binding is read only")
+		}
+		if r.Location == nil {
+			return Resolved{}, fail("resource_not_file", "resource uses a native configuration service, not a file location")
+		}
+		if err := checkLocation(*r.Location); err != nil {
+			return Resolved{}, err
+		}
+		return Resolved{Descriptor: d, Path: filepath.Join(r.Location.Root, filepath.FromSlash(r.Location.RelativePath)), RelativePath: r.Location.RelativePath}, nil
+	}
+	return Resolved{}, fail("resource_not_bound", "resource is not bound")
+}
+
+func (s *Set) Manifest() Manifest {
+	m := Manifest{Schema: 1, Scope: s.scope, Resources: s.List(), Bindings: make([]Binding, 0, len(s.records))}
+	for _, r := range s.records {
+		m.Bindings = append(m.Bindings, r.Binding)
+	}
+	return m
+}
+
+func cloneRecord(r Record) Record {
+	r.Descriptor = cloneDescriptor(r.Descriptor)
+	if r.Location != nil {
+		l := *r.Location
+		r.Location = &l
+	}
+	return r
+}
+
+func cloneDescriptor(d Descriptor) Descriptor {
+	if d.Configuration != nil {
+		c := *d.Configuration
+		c.Names = append([]string(nil), c.Names...)
+		d.Configuration = &c
+	}
+	if d.Policy != nil {
+		p := *d.Policy
+		if p.NetworkAccess != nil {
+			v := *p.NetworkAccess
+			p.NetworkAccess = &v
+		}
+		d.Policy = &p
+	}
+	return d
+}
+
+var _ Catalog = (*Set)(nil)
+var _ Bindings = (*Set)(nil)
+var _ Resolver = (*Set)(nil)
diff --git a/internal/resource/resource_test.go b/internal/resource/resource_test.go
new file mode 100644
index 0000000..0afb8f0
--- /dev/null
+++ b/internal/resource/resource_test.go
@@ -0,0 +1,121 @@
+package resource
+
+import (
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func fileSet(t *testing.T, root, relative string) (*Set, Scope, Ref) {
+	t.Helper()
+	scope := Scope{InstanceID: "instance", WorkspaceID: "workspace", SessionID: "session"}
+	ref := Ref{Kind: KindOutputs, ID: "session", Version: "version-2"}
+	set, err := NewSet(scope, []Record{{
+		Descriptor: Descriptor{Ref: ref, Owner: scope, Storage: Reference, Source: Source{System: "workspace", ID: "workspace"}, VersionKind: "binding"},
+		Binding:    Binding{Role: RoleOutputs, Ref: ref, Access: Read}, Location: &Location{Root: root, RelativePath: relative},
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return set, scope, ref
+}
+
+func requireCode(t *testing.T, err error, code string) {
+	t.Helper()
+	var failure *Error
+	if !errors.As(err, &failure) || failure.Code != code {
+		t.Fatalf("want %s, got %v", code, err)
+	}
+}
+
+func TestResolveRejectsDifferentScopeVersionAndWriteAccess(t *testing.T) {
+	set, scope, ref := fileSet(t, t.TempDir(), "outputs/session")
+	other := scope
+	other.SessionID = "other"
+	_, err := set.Resolve(other, ref, Read)
+	requireCode(t, err, "resource_scope_mismatch")
+	old := ref
+	old.Version = "version-1"
+	_, err = set.Resolve(scope, old, Read)
+	requireCode(t, err, "resource_version_changed")
+	_, err = set.Resolve(scope, ref, Write)
+	requireCode(t, err, "resource_read_only")
+	unknown := ref
+	unknown.ID = "not-bound"
+	_, err = set.Resolve(scope, unknown, Read)
+	requireCode(t, err, "resource_not_bound")
+}
+
+func TestPortableLocationsAndManifestDoNotLeakHostPath(t *testing.T) {
+	root := t.TempDir()
+	set, scope, ref := fileSet(t, root, "outputs/session")
+	resolved, err := set.Resolve(scope, ref, Read)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if resolved.Path != filepath.Join(root, "outputs", "session") || resolved.RelativePath != "outputs/session" {
+		t.Fatalf("portable binding resolved incorrectly: %+v", resolved)
+	}
+	data, err := json.Marshal(set.Manifest())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(data), filepath.Base(root)) || strings.Contains(string(data), "relativePath") {
+		t.Fatalf("public manifest leaked location: %s", data)
+	}
+	resolvedJSON, err := json.Marshal(resolved)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(resolvedJSON), filepath.Base(root)) {
+		t.Fatal("resolved host location leaked through serialization")
+	}
+	if _, err := os.Stat(resolved.Path); !os.IsNotExist(err) {
+		t.Fatalf("resolution created native directories: %v", err)
+	}
+}
+
+func TestRejectLocationsEscapingRootsAndSymlinkAliases(t *testing.T) {
+	root := t.TempDir()
+	for _, relative := range []string{"../outside", "a/../../outside", "/absolute", "a/../outside", "a\\outside", "C:/outside", ".", "a\x00b"} {
+		if err := validateLocation(Location{Root: root, RelativePath: relative}); err == nil {
+			t.Fatalf("unsafe or noncanonical relative path accepted: %q", relative)
+		}
+	}
+	outside := t.TempDir()
+	if err := os.Symlink(outside, filepath.Join(root, "outputs")); err != nil {
+		t.Skipf("symlinks unavailable: %v", err)
+	}
+	set, scope, ref := fileSet(t, root, "outputs/session")
+	_, err := set.Resolve(scope, ref, Read)
+	requireCode(t, err, "resource_path_invalid")
+}
+
+func TestSetOwnsImmutableMetadataAndRejectsForeignOwner(t *testing.T) {
+	value := true
+	ref := Ref{Kind: KindPolicy, ID: "instance", Version: "4"}
+	scope := Scope{InstanceID: "instance", SessionID: "session"}
+	record := Record{Descriptor: Descriptor{Ref: ref, Owner: Scope{InstanceID: "instance"}, Storage: Managed, VersionKind: "binding", Policy: &Policy{NetworkAccess: &value}}, Binding: Binding{Role: RolePolicy, Ref: ref, Access: Read}}
+	set, err := NewSet(scope, []Record{record})
+	if err != nil {
+		t.Fatal(err)
+	}
+	value = false
+	manifest := set.Manifest()
+	if !*manifest.Resources[0].Policy.NetworkAccess {
+		t.Fatal("caller mutated constructed snapshot")
+	}
+	*manifest.Resources[0].Policy.NetworkAccess = false
+	current, err := set.Describe(ref)
+	if err != nil || !*current.Policy.NetworkAccess {
+		t.Fatal("caller mutated returned snapshot")
+	}
+	record.Descriptor.Owner.InstanceID = "other-instance"
+	_, err = NewSet(scope, []Record{record})
+	requireCode(t, err, "resource_scope_mismatch")
+	_, err = set.Resolve(scope, ref, Read)
+	requireCode(t, err, "resource_not_file")
+}
