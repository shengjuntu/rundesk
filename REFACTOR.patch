@@ -0,0 +1,174 @@
+package app
+
+import (
+	"errors"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	p "github.com/your-org/kun/sdk/protocol"
+	"github.com/shengjuntu/rundesk/internal/resource"
+	"github.com/shengjuntu/rundesk/internal/store"
+)
+
+func TestRuntimeAdmissionKeepsNativeCapabilitiesSeparate(t *testing.T) {
+	for _, test := range []struct {
+		kind      string
+		admission RuntimeAdmission
+		code      string
+	}{
+		{"kun", RuntimeAdmission{Input: Input{Text: "image", Files: []string{"uploads/a.PNG"}}}, "kun_text_only"},
+		{"kun", RuntimeAdmission{Input: Input{Text: "recover"}, Recovery: &RecoveryPlan{}}, "kun_recovery_unsupported"},
+		{"kun", RuntimeAdmission{Session: Session{TraceOrigin: &TraceOrigin{}}, Input: Input{Text: "diagnose", Skills: []Skill{{Name: "extra"}}}}, "diagnostic_input_only"},
+		{"codex", RuntimeAdmission{Input: Input{Text: "resume", KunResume: &kunResumeInput{}}}, "not_kun"},
+		{"codex", RuntimeAdmission{Input: Input{Text: "fast", FastSkillID: "kun-skill"}}, "skill_ordinary_application_only"},
+	} {
+		t.Run(test.kind+"/"+test.code, func(t *testing.T) {
+			backend, err := newRuntimeBackend(test.kind, runtimeServices{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			_, err = backend.Prepare(test.admission)
+			var api *apiError
+			if !errors.As(err, &api) || api.Code != test.code {
+				t.Fatalf("got %v, want %s", err, test.code)
+			}
+		})
+	}
+}
+
+// A stop captured during an earlier starting run must not close a later run's
+// connection, even if the stop dispatch is delayed until after replacement.
+func TestRuntimeStaleCodexStopDoesNotCloseReplacement(t *testing.T) {
+	m := testManager(t)
+	s, err := m.CreateSession(m.Workspaces()[0].ID, "", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := m.Start(s.ID, Input{Text: "审批 first"}); err != nil {
+		t.Fatal(err)
+	}
+	first := waitState(t, m, s.ID, "waiting")
+	stale := first
+	stale.Status, stale.TurnID = "starting", ""
+	if err := m.StopRun(s.ID, first.RunID); err != nil {
+		t.Fatal(err)
+	}
+	waitState(t, m, s.ID, "interrupted")
+	if _, err := m.Start(s.ID, Input{Text: "审批 second"}); err != nil {
+		t.Fatal(err)
+	}
+	second := waitState(t, m, s.ID, "waiting")
+	h, _ := m.getHandle(s.ID)
+	h.mu.Lock()
+	client := h.client
+	h.mu.Unlock()
+	m.codexRuntime().Stop(RuntimeStop{Session: stale, Handle: h})
+	if client.Closing() {
+		t.Fatal("stale starting-run stop closed the replacement transport")
+	}
+	current, err := m.Session(s.ID)
+	if err != nil || current.RunID != second.RunID || current.Status != "waiting" {
+		t.Fatal(current, err)
+	}
+	if err := m.StopRun(s.ID, second.RunID); err != nil {
+		t.Fatal(err)
+	}
+	waitState(t, m, s.ID, "interrupted")
+}
+
+func TestRuntimeKunJournalKeepsCursorAndProjectionAtomic(t *testing.T) {
+	m := testManager(t)
+	s, _ := m.CreateSession(m.Workspaces()[0].ID, "", "")
+	if err := m.update(s.ID, func(s *Session) { s.RunID = "current"; s.Status = "starting" }); err != nil {
+		t.Fatal(err)
+	}
+	journal := kunJournalHost{m}
+	event := p.Event{SessionID: s.ID, RunID: "current", Sequence: 1, Time: store.Now(), Type: "kun/run.started", Data: p.JSON(map[string]any{})}
+	if terminal, err := journal.Import(s.ID, event); err != nil || terminal {
+		t.Fatal(terminal, err)
+	}
+	event.Sequence, event.Type, event.Data = 3, "kun/run.finished", p.JSON(map[string]string{"status": "completed"})
+	if _, err := journal.Import(s.ID, event); err == nil {
+		t.Fatal("gap accepted")
+	}
+	current, _ := m.Session(s.ID)
+	cursor, _ := journal.Cursor(s.ID)
+	if current.Status != "running" || cursor != 1 {
+		t.Fatal("failed import changed projection", current, cursor)
+	}
+	event.Sequence, event.RunID = 2, "old"
+	if terminal, err := journal.Import(s.ID, event); err != nil || terminal {
+		t.Fatal(terminal, err)
+	}
+	current, _ = m.Session(s.ID)
+	if current.Status != "running" {
+		t.Fatal("old run event completed current run", current)
+	}
+	event.Sequence, event.RunID = 3, "current"
+	if terminal, err := journal.Import(s.ID, event); err != nil || !terminal {
+		t.Fatal(terminal, err)
+	}
+	current, _ = m.Session(s.ID)
+	var saved Session
+	if err := m.Store.Get("session", s.ID, &saved); err != nil {
+		t.Fatal(err)
+	}
+	cursor, _ = journal.Cursor(s.ID)
+	if current.Status != "completed" || saved.Status != current.Status || cursor != 3 {
+		t.Fatal("projection not committed together", current, saved, cursor)
+	}
+}
+
+type remappedRuntimeResources struct {
+	original RuntimeResourceService
+	seen     map[resource.Role]bool
+}
+
+func (s remappedRuntimeResources) Resolve(session Session, role resource.Role) (resource.Resolved, error) {
+	s.seen[role] = true
+	resolved, err := s.original.Resolve(session, role)
+	if err == nil && role == resource.RoleOutputs {
+		resolved.RelativePath = filepath.Join("outputs", "bound-destination")
+		workspace, e := s.original.Resolve(session, resource.RoleWorkspace)
+		if e != nil {
+			return resolved, e
+		}
+		resolved.Path = filepath.Join(workspace.Path, resolved.RelativePath)
+	}
+	return resolved, err
+}
+
+func TestRuntimeKunRequestConsumesResourceAndPolicyServices(t *testing.T) {
+	m := testManager(t)
+	m.Demo = false
+	i, _ := m.Instance()
+	config := p.Config{Kind: "kun", Endpoint: "http://127.0.0.1:1/v1", Model: "fixture", AllowWrite: true}
+	if _, err := m.SetAgentRuntime(i.ID, i.Revision, config); err != nil {
+		t.Fatal(err)
+	}
+	w := m.Workspaces()[0]
+	s, err := m.CreateSession(w.ID, "", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	backend := m.kunRuntime()
+	seen := map[resource.Role]bool{}
+	backend.resources = remappedRuntimeResources{original: m.ResourceService(), seen: seen}
+	request, err := backend.startRequest(s, w, Input{Text: "do the work"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !seen[resource.RoleWorkspace] || !seen[resource.RoleOutputs] || request.Workspace != w.Path || !strings.Contains(request.Input, "outputs/bound-destination") {
+		t.Fatal("request ignored its resource bindings", request, seen)
+	}
+	i, _ = m.Instance()
+	readOnly := Permissions{Sandbox: "read-only", ApprovalPolicy: "never"}
+	if _, err = m.PatchInstance(i.ID, InstancePatch{Name: i.Name, Revision: i.Revision, Permissions: &readOnly}); err != nil {
+		t.Fatal(err)
+	}
+	request, err = backend.startRequest(s, w, Input{Text: "read only"})
+	if err != nil || request.Config.AllowWrite || request.ApprovalPolicy != "never" {
+		t.Fatal("request ignored policy", request.Config, request.ApprovalPolicy, err)
+	}
+}
diff --git a/internal/app/runtime_codex.go b/internal/app/runtime_codex.go
new file mode 100644
index 0000000..04f80ce
--- /dev/null
+++ b/internal/app/runtime_codex.go
@@ -0,0 +1,264 @@
+package app
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/shengjuntu/rundesk/internal/resource"
+)
+
+func (b codexBackend) Run(run RuntimeRun) {
+	s, w, h, in, recovery := run.Session, run.Workspace, run.Handle, run.Input, run.Recovery
+	fail := func(e error) {
+		h.mu.Lock()
+		c := h.client
+		h.client = nil
+		h.thread = ""
+		canceled := h.canceled || b.state.Context().Err() != nil
+		h.mu.Unlock()
+		if c != nil {
+			c.Close()
+			<-c.Done()
+		}
+		b.transport.ObservationDisconnected(s.ID)
+		b.transport.ExpireApprovals(s.ID, h)
+		if canceled {
+			b.state.Finish(s.ID, "interrupted", "")
+		} else {
+			b.state.Finish(s.ID, "failed", e.Error())
+		}
+	}
+	workspace, e := b.resources.Resolve(s, resource.RoleWorkspace)
+	if e != nil {
+		fail(e)
+		return
+	}
+	w.Path = workspace.Path
+	outputs, e := b.resources.Resolve(s, resource.RoleOutputs)
+	if e != nil {
+		fail(e)
+		return
+	}
+	if e := b.transport.CheckBuildAssistantExecution(s); e != nil {
+		fail(e)
+		return
+	}
+	permissions, e := b.policy.Permissions(s)
+	if e != nil {
+		fail(e)
+		return
+	}
+	if s.TraceOrigin != nil {
+		permissions.Sandbox = "read-only"
+		permissions.NetworkAccess = nil
+	}
+	h.mu.Lock()
+	old := h.client
+	changed := old != nil && (h.permissionsKey != "" && h.permissionsKey != permissions.key() || h.thread != "" && h.observationEnabled != s.ObserveHTTP)
+	if changed {
+		h.client = nil
+		h.thread = ""
+	}
+	h.mu.Unlock()
+	if changed {
+		old.Close()
+		<-old.Done()
+	}
+	c, e := b.transport.Connect(s.ID, w, h, s.InstanceID)
+	if e != nil {
+		fail(e)
+		return
+	}
+	ctx, cancel := context.WithTimeout(b.state.Context(), 90*time.Second)
+	defer cancel()
+	h.mu.Lock()
+	canceled := h.canceled
+	h.mu.Unlock()
+	if canceled {
+		b.state.Finish(s.ID, "interrupted", "")
+		return
+	}
+	// A fresh process must resume the native thread before it can accept a turn.
+	h.mu.Lock()
+	ready := h.thread != "" && h.thread == s.ThreadID
+	h.mu.Unlock()
+	var raw json.RawMessage
+	if !ready {
+		params := permissions.threadParams(w.Path)
+		if e := b.transport.ConfigureBuildAssistant(s, w, params); e != nil {
+			fail(e)
+			return
+		}
+		captureConfigured := b.transport.ConfigureHTTPObservation(ctx, c, s, w, params)
+		if s.TraceOrigin != nil {
+			if e := b.transport.ConfigureTraceAnalysis(s, params); e != nil {
+				fail(e)
+				return
+			}
+		}
+		if s.Model != "" {
+			params["model"] = s.Model
+		}
+		method := "thread/start"
+		if s.ThreadID != "" {
+			method = "thread/resume"
+			params["threadId"] = s.ThreadID
+			params["excludeTurns"] = true
+		}
+		raw, e = c.Call(ctx, method, params)
+		if e != nil {
+			fail(fmt.Errorf("Codex %s: %w", method, e))
+			return
+		}
+		var res struct {
+			Thread struct {
+				ID string `json:"id"`
+			} `json:"thread"`
+		}
+		if e = json.Unmarshal(raw, &res); e != nil || res.Thread.ID == "" {
+			fail(errors.New("thread/start/resume 未返回 thread.id"))
+			return
+		}
+		s.ThreadID = res.Thread.ID
+		if e = b.state.Update(s.ID, func(v *Session) { v.ThreadID = s.ThreadID }); e != nil {
+			fail(e)
+			return
+		}
+		h.mu.Lock()
+		h.thread = s.ThreadID
+		h.permissionsKey = permissions.key()
+		h.observationEnabled = s.ObserveHTTP
+		h.mu.Unlock()
+		if captureConfigured {
+			b.transport.ObservationApplied(s.ID, s.ObserveHTTP)
+		}
+		b.transport.RecordEffective(s.ID, raw, permissions)
+	}
+	// Reload queues updated MCP configuration for the next turn on this thread.
+	if _, e = c.Call(ctx, "config/mcpServer/reload", map[string]any{}); e != nil {
+		fail(fmt.Errorf("MCP reload: %w", e))
+		return
+	}
+	root, e := os.OpenRoot(w.Path)
+	if e != nil {
+		fail(e)
+		return
+	}
+	e = root.MkdirAll(outputs.RelativePath, 0700)
+	root.Close()
+	if e != nil {
+		fail(e)
+		return
+	}
+	text := in.Text
+	text += recoveryInstructions(recovery)
+	if s.TraceOrigin != nil {
+		text += traceAnalysisInstructions(s.TraceOrigin)
+	}
+	if w.Notes != "" {
+		text += "\n\n<project-notes revision=\"" + fmt.Sprint(w.Revision) + "\">\n" + w.Notes + "\n</project-notes>"
+	}
+	text += "\n\n[Application context] Save deliverable files in " + outputs.Path + ". Uploaded files, if any, are listed below."
+	input := []any{}
+	for _, f := range in.Files {
+		path := filepath.Join(w.Path, filepath.FromSlash(f))
+		text += "\nUploaded file: " + path
+		ext := strings.ToLower(filepath.Ext(f))
+		if ext == ".png" || ext == ".jpg" || ext == ".jpeg" || ext == ".webp" {
+			input = append(input, map[string]string{"type": "localImage", "path": path})
+		}
+	}
+	input = append(input, map[string]string{"type": "text", "text": text})
+	for _, sk := range in.Skills {
+		input = append(input, map[string]string{"type": "skill", "name": sk.Name, "path": sk.Path})
+	}
+	h.mu.Lock()
+	canceled = h.canceled
+	h.mu.Unlock()
+	if canceled {
+		b.state.Finish(s.ID, "interrupted", "")
+		return
+	}
+	turnParams := map[string]any{"threadId": s.ThreadID, "input": input}
+	// A continued turn can select another available model even while the native
+	// thread connection remains open. Thread-level setup alone would leave that
+	// turn using the earlier model.
+	if s.Model != "" {
+		turnParams["model"] = s.Model
+	}
+	raw, e = c.Call(ctx, "turn/start", turnParams)
+	if e != nil {
+		fail(fmt.Errorf("Codex turn/start: %w", e))
+		return
+	}
+	var result struct {
+		Turn struct {
+			ID string `json:"id"`
+		} `json:"turn"`
+	}
+	if e = json.Unmarshal(raw, &result); e != nil || result.Turn.ID == "" {
+		fail(errors.New("Codex turn/start 未返回有效 turn.id；提交结果无法确认，未自动重发，请核对原生线程"))
+		return
+	}
+	_ = b.state.Update(s.ID, func(v *Session) {
+		if v.TurnID == "" {
+			v.TurnID = result.Turn.ID
+		}
+		if v.Status == "starting" {
+			v.Status = "running"
+		}
+	})
+	h.mu.Lock()
+	canceled = h.canceled
+	h.mu.Unlock()
+	if canceled {
+		b.state.Go(func() { b.interrupt(s.ID, h, s.RunID) })
+	}
+}
+
+// Stop aborts an in-flight turn submission before waiting for the run lock.
+// A request tied to an old run is still checked by interrupt before any native
+// turn is canceled.
+func (b codexBackend) Stop(stop RuntimeStop) {
+	s, h := stop.Session, stop.Handle
+	current, err := b.state.Session(s.ID)
+	if err != nil || current.RunID != s.RunID || !active(current.Status) {
+		return
+	}
+	h.mu.Lock()
+	if s.Status == "starting" && s.TurnID == "" && h.client != nil {
+		h.client.Close()
+	}
+	h.mu.Unlock()
+	b.state.Go(func() { b.interrupt(s.ID, h, s.RunID) })
+}
+
+func (b codexBackend) interrupt(id string, h *handle, expectedRunIDs ...string) {
+	h.op.Lock()
+	defer h.op.Unlock()
+	s, e := b.state.Session(id)
+	if e != nil || !active(s.Status) || (len(expectedRunIDs) > 0 && s.RunID != expectedRunIDs[0]) {
+		return
+	}
+	h.mu.Lock()
+	c := h.client
+	h.mu.Unlock()
+	if c == nil || s.TurnID == "" {
+		b.state.Finish(id, "interrupted", "")
+		return
+	}
+	ctx, cancel := context.WithTimeout(b.state.Context(), 10*time.Second)
+	defer cancel()
+	_, e = c.Call(ctx, "turn/interrupt", map[string]string{"threadId": s.ThreadID, "turnId": s.TurnID})
+	if e != nil {
+		c.Close()
+		b.state.Finish(id, "interrupted", e.Error())
+	}
+	b.transport.ExpireApprovals(id, h)
+}
diff --git a/internal/app/runtime_host.go b/internal/app/runtime_host.go
new file mode 100644
index 0000000..b30cc30
--- /dev/null
+++ b/internal/app/runtime_host.go
@@ -0,0 +1,199 @@
+package app
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+
+	kc "github.com/your-org/kun/sdk/client"
+	p "github.com/your-org/kun/sdk/protocol"
+	"github.com/shengjuntu/rundesk/internal/rpc"
+	"github.com/shengjuntu/rundesk/internal/store"
+)
+
+// This is the composition boundary. Only host-side adapters know Manager;
+// backends receive purpose-specific service interfaces and cannot reach its
+// maps, locks, queue, Store, or credential management.
+func (m *Manager) runtimeServices() runtimeServices {
+	return runtimeServices{
+		resources: m.ResourceService(), state: runtimeSessionHost{m}, policy: runtimePolicyHost{m},
+		instances: runtimeInstanceHost{m}, codex: codexRuntimeHost{m},
+		kunPrepare: kunPreparationHost{m}, kunProcess: kunProcessHost{m},
+		kunJournal: kunJournalHost{m},
+	}
+}
+func (m *Manager) runtimeBackend(kind string) (RuntimeBackend, error) {
+	return newRuntimeBackend(kind, m.runtimeServices())
+}
+func (m *Manager) codexRuntime() codexBackend {
+	s := m.runtimeServices()
+	return codexBackend{resources: s.resources, state: s.state, policy: s.policy, transport: s.codex}
+}
+func (m *Manager) kunRuntime() kunBackend {
+	s := m.runtimeServices()
+	return kunBackend{resources: s.resources, state: s.state, policy: s.policy, instances: s.instances, preparation: s.kunPrepare, process: s.kunProcess, journal: s.kunJournal}
+}
+
+// Native diagnostic/configuration entry points use the same backend modules.
+func (m *Manager) kunStartRequest(s Session, w Workspace, in Input) (p.Start, error) {
+	return m.kunRuntime().startRequest(s, w, in)
+}
+func (m *Manager) ensureKunWorker(s Session, h *handle) (*kc.Client, error) {
+	return m.kunRuntime().ensureWorker(s, h)
+}
+func (m *Manager) interrupt(id string, h *handle, expectedRunIDs ...string) {
+	m.codexRuntime().interrupt(id, h, expectedRunIDs...)
+}
+
+type runtimeSessionHost struct{ m *Manager }
+
+func (s runtimeSessionHost) Context() context.Context           { return s.m.ctx }
