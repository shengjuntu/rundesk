+	if err != nil {
+		t.Fatal(err)
+	}
+	files, err := os.ReadDir(filepath.Dir(export.Path))
+	if err != nil || len(files) != 1 || files[0].Name() != "resources.json" {
+		t.Fatalf("export copied more than the reference view: %v %v", files, err)
+	}
+	data, err := os.ReadFile(export.Path)
+	if err != nil {
+		t.Fatal(err)
