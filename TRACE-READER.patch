diff --git a/internal/web/trace-reader.css b/internal/web/trace-reader.css
new file mode 100644
index 0000000..e373f1d
--- /dev/null
+++ b/internal/web/trace-reader.css
@@ -0,0 +1,37 @@
+/* The reading surface stays bounded by server pagination; evidence is lazy. */
+.trace-reader{--trace-line:var(--border,#d9dfe6);display:grid;grid-template-columns:210px minmax(0,1fr);gap:30px;align-items:start;min-height:400px}
+.trace-reader.has-evidence{grid-template-columns:180px minmax(280px,1fr) minmax(280px,.8fr);gap:22px}
+.trace-run-nav{position:sticky;top:0;min-width:0;padding-right:18px;border-right:1px solid var(--trace-line)}
+.trace-run-outline>summary{font-size:12px;font-weight:650;letter-spacing:.04em;color:var(--muted,#64748b);padding:8px 0 14px;cursor:pointer}
+.trace-run-list{display:grid;gap:5px;max-height:54vh;overflow:auto;scrollbar-width:thin}
+.trace-run-nav .trace-run{display:grid;gap:6px;width:100%;min-width:0;text-align:left;white-space:normal;border:1px solid transparent;background:transparent;box-shadow:none;border-radius:8px;padding:10px;line-height:1.45;color:inherit}
+.trace-run small{font-size:10px;letter-spacing:.03em}.trace-run span{font-size:12px;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
+.trace-run-nav .trace-run[aria-current=true]{background:var(--soft,#f4f6f9);border-color:var(--trace-line)}
+.trace-run-pages{display:flex;flex-wrap:wrap;gap:6px;justify-content:space-between;align-items:center;margin-top:14px;font-size:10px}.trace-run-pages button{font-size:10px;padding:5px}.trace-run-status{width:100%;text-align:center;color:var(--muted,#64748b);order:3}
+.trace-content{min-width:0;max-width:920px;width:100%;margin:0 auto}.trace-reading-toolbar{display:flex;align-items:center;flex-wrap:wrap;gap:14px;padding:5px 0 8px;border-bottom:1px solid var(--trace-line)}
+.trace-reading-toolbar input[type=search]{border:0;background:var(--soft,#f4f6f9);color:inherit;border-radius:7px;padding:9px 11px;flex:1;min-width:150px;max-width:330px;font-size:12px}
