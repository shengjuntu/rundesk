{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rundesk:runtime-profile:1",
  "title": "RunDesk runtime profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "runtime",
    "id",
    "title",
    "description",
    "searchBackends",
    "defaultSearchBackend",
    "aptPackages",
    "pythonPackages",
    "skill",
    "tools",
    "outputs",
    "resources",
    "optionalComponents"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "const": "codex-docker"
    },
    "searchBackends": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "exa",
          "none"
        ]
      }
    },
    "defaultSearchBackend": {
      "enum": [
        "exa",
        "none"
      ]
    },
    "aptPackages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9+.-]*$"
      }
    },
    "pythonPackages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "skill": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,64}$"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpus",
        "memoryMB",
        "network"
      ],
      "properties": {
        "cpus": {
          "type": "integer",
          "minimum": 1
        },
        "memoryMB": {
          "type": "integer",
          "minimum": 256
        },
        "network": {
          "enum": [
            "bridge",
            "none"
          ]
        }
      }
    },
    "optionalComponents": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "agent-reach"
        ]
      }
    }
  }
}
