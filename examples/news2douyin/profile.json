{
  "schemaVersion": 1,
  "version": "1.0.0",
  "runtime": "codex-docker",
  "id": "news2douyin",
  "title": "新闻采集与短视频准备",
  "description": "搜索新闻、读取原文和字幕、保存证据并准备短视频素材；不包含 news2douyin 应用本体或自动发布。",
  "searchBackends": [
    "exa",
    "wigolo"
  ],
  "defaultSearchBackend": "exa",
  "aptPackages": [
    "ffmpeg",
    "fonts-noto-cjk",
    "fontconfig"
  ],
  "pythonPackages": [
    "feedparser",
    "yt-dlp",
    "Pillow"
  ],
  "skill": "collect-news-evidence",
  "tools": [
    "Python 3",
    "Node.js",
    "Git",
    "curl",
    "ripgrep",
    "feedparser",
    "yt-dlp",
    "FFmpeg",
    "Pillow",
    "Noto CJK"
  ],
  "outputs": [
    "sources.json",
    "brief.md",
    "script.md",
    "assets/"
  ],
  "resources": {
    "cpus": 2,
    "memoryMB": 2048,
    "wigoloMemoryMB": 4096,
    "network": "bridge"
  },
  "optionalComponents": [
    "agent-reach"
  ]
}
