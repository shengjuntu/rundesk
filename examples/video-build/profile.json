{
  "schemaVersion": 1,
  "version": "1.4.0",
  "runtime": "codex-docker",
  "id": "video-build",
  "title": "文字驱动视频制作",
  "description": "Codex自主分镜、选材与动画制作；默认HyperFrames、GSAP、Chromium、FFmpeg与中文字体。TTS、图片/视频生成及工程提交/检查/渲染由Video App MCP提供；video-use为可选旧项目兼容。",
  "searchBackends": [
    "none"
  ],
  "defaultSearchBackend": "none",
  "aptPackages": [
    "ffmpeg",
    "fonts-noto-cjk",
    "fontconfig",
    "chromium"
  ],
  "pythonPackages": [
    "Pillow"
  ],
  "skill": "build-video-artifacts",
  "tools": [
    "Python 3",
    "Node.js 22+",
    "Git",
    "curl",
    "ripgrep",
    "FFmpeg",
    "ffprobe",
    "Pillow",
    "Noto CJK",
    "Chromium",
    "HyperFrames 0.8.87",
    "GSAP 3.15.0"
  ],
  "outputs": [
    "hyperframes-project",
    "final.mp4",
    "validation.json"
  ],
  "resources": {
    "cpus": 4,
    "memoryMB": 4096,
    "network": "bridge"
  },
  "optionalComponents": [
    "video-use"
  ],
  "skillFiles": [
    "SKILL.md",
    "agents/openai.yaml",
    "references/hyperframes-authoring.md",
    "references/backend-compatibility.md"
  ]
}
