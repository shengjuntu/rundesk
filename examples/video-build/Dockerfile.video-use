# Editable RunDesk Dockerfile. Keep profile.lock.json and source settings with this recipe.
ARG RD_BASE_IMAGE=node:22-bookworm-slim
FROM ${RD_BASE_IMAGE}
# All managed profiles require the Node runtime and unprivileged node user.
RUN node -e 'if (Number(process.versions.node.split(".")[0]) < 22) process.exit(1)' && npm --version >/dev/null && id node >/dev/null
ARG RD_APT_MIRROR=http://deb.debian.org/debian
ARG RD_APT_SECURITY_MIRROR=http://deb.debian.org/debian-security
COPY tools/configure-apt.sh /opt/rundesk-profile/tools/configure-apt.sh
RUN RD_APT_MIRROR="${RD_APT_MIRROR}" RD_APT_SECURITY_MIRROR="${RD_APT_SECURITY_MIRROR}" sh /opt/rundesk-profile/tools/configure-apt.sh && apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=60 update && apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=60 install -y --no-install-recommends ca-certificates chromium curl ffmpeg fontconfig fonts-noto-cjk git python3 python3-venv ripgrep && rm -rf /var/lib/apt/lists/*
ARG RD_NPM_REGISTRY=https://registry.npmjs.org
ARG RD_PIP_INDEX_URL=https://pypi.org/simple
ENV npm_config_fetch_retries=3 npm_config_fetch_timeout=120000
RUN python3 -m venv /opt/rundesk-python
ENV PATH="/opt/rundesk-python/bin:${PATH}" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements.txt /opt/rundesk-profile/requirements.txt
RUN PIP_INDEX_URL="${RD_PIP_INDEX_URL}" python3 -m pip install --retries 3 --timeout 60 --no-cache-dir --no-deps -r /opt/rundesk-profile/requirements.txt && python3 -m pip check
COPY vendor/video-use.tar.gz /opt/rundesk-profile/video-use.tar.gz
RUN echo 'b7c181c855265f5e88a2bacde46959b3a07034ee7dce00aed1f4b00bce6a3367  /opt/rundesk-profile/video-use.tar.gz' | sha256sum -c - && mkdir -p /opt/video-use && tar -xzf /opt/rundesk-profile/video-use.tar.gz --strip-components=1 -C /opt/video-use && rm /opt/rundesk-profile/video-use.tar.gz
COPY vendor/video-use-pin.json /opt/video-use/RUNDESK_PIN.json
RUN chmod -R a+rX /opt/video-use && test -f /opt/video-use/LICENSE && test -f /opt/video-use/helpers/render.py
COPY hyperframes/ /opt/hyperframes/
RUN npm_config_registry="${RD_NPM_REGISTRY}" npm ci --prefix /opt/hyperframes --omit=dev --no-audit --no-fund && npm cache clean --force
ENV PATH="/opt/hyperframes/node_modules/.bin:${PATH}" HYPERFRAMES_BROWSER_PATH=/usr/bin/chromium HYPERFRAMES_NO_TELEMETRY=1 DO_NOT_TRACK=1
RUN hyperframes --version && chromium --version && node -e "if (Number(process.versions.node.split('.')[0]) < 22) process.exit(1)"
ARG CODEX_VERSION=0.0.0
ARG RD_CODEX_MODE=auto
COPY runtime/ /opt/rundesk-runtime/
COPY tools/install-codex.sh /opt/rundesk-profile/tools/install-codex.sh
RUN CODEX_VERSION="${CODEX_VERSION}" RD_CODEX_MODE="${RD_CODEX_MODE}" RD_NPM_REGISTRY="${RD_NPM_REGISTRY}" sh /opt/rundesk-profile/tools/install-codex.sh
LABEL org.opencontainers.image.title="RunDesk video-build"
LABEL org.opencontainers.image.version="1.4.0"
LABEL io.rundesk.profile="video-build"
LABEL io.rundesk.profile.schema="1"
LABEL io.rundesk.codex.version="0.0.0"
LABEL io.rundesk.agent-reach="false"
LABEL io.rundesk.capabilities.tools="Python 3, Node.js 22+, Git, curl, ripgrep, FFmpeg, ffprobe, Pillow, Noto CJK, Chromium, HyperFrames 0.8.87, GSAP 3.15.0"
LABEL io.rundesk.capabilities.skills="build-video-artifacts"
LABEL io.rundesk.capabilities.mcp="none"
LABEL io.rundesk.hyperframes.version="0.8.87"
LABEL io.rundesk.gsap.version="3.15.0"
LABEL io.rundesk.hyperframes.lock="b3f48e9687cd27dea097203e928e6e7fd84344b88122ab2bb546d38b48705de1"
LABEL io.rundesk.video-use.enabled="true"
LABEL io.rundesk.video-use.commit="43cfc566833548093455c9d4a46bd69913b7e552"
LABEL io.rundesk.video-use.adapter="2"
COPY skills/ /etc/codex/skills/
COPY seed/ /opt/rundesk-seed/
COPY tools/ /opt/rundesk-profile/tools/
COPY profile.lock.json /opt/rundesk-profile/profile.lock.json
COPY THIRD_PARTY.md /opt/rundesk-profile/THIRD_PARTY.md
RUN mkdir -p /opt/rundesk/bin && chmod -R a+rX /opt/rundesk-profile /etc/codex/skills /opt/rundesk-seed
USER node
WORKDIR /home/node
CMD ["codex", "app-server"]
