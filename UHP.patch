+func uhpFileErrorCode(t *testing.T, err error, status int, code string) {
+	t.Helper()
+	var api *apiError
+	if !errors.As(err, &api) || api.Status != status || api.Code != code {
+		t.Fatalf("wanted %d %s, got %v", status, code, err)
