diff --git a/internal/app/uhp.go b/internal/app/uhp.go
new file mode 100644
index 0000000..4700fbf
--- /dev/null
+++ b/internal/app/uhp.go
@@ -0,0 +1,426 @@
+package app
+
+// UHP is a wire adapter over the task kernel. Native runtimes remain behind
+// TaskControl; these records are protocol identities/projections, not a queue.
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"sort"
+	"strings"
+	"time"
+)
+
+const UHPVersion = "2026-10-19"
+
+type uhpError struct {
+	Type    string  `json:"type"`
+	Code    string  `json:"code"`
+	Message string  `json:"message"`
+	Param   *string `json:"param"`
+	Detail  any     `json:"detail"`
+}
+
+type uhpRecord struct {
+	BeforeFiles   []string
+	Owner         string
+	Harness       uhpHarness
+	HostSessionID string
+	SessionID     string
+	ContainerID   string
+	TaskID        string
+	Projection    uhpProjection
+	Input         json.RawMessage
+	Cursor        int64
+	Deleted       bool
+	CancelReason  string
+	Deadline      int64
+	MaxStep       int
+	CompletedAt   int64
+}
+type uhpSessionRecord struct {
+	ID            string
+	Owner         string
+	Harness       uhpHarness
+	HostSessionID string
+	ContainerID   string
+	ResponseIDs   []string
+	CreatedAt     int64
+	Deleted       bool
+}
+type uhpReceipt struct{ ResponseID string }
+type uhpService struct{ server *Server }
+
+func uhpOwner(r *http.Request) string {
+	if k := principal(r); k != nil {
+		return "application-key:" + k.ID
+	}
+	return "administrator"
+}
+func uhpFail(w http.ResponseWriter, status int, code, message string) {
+	kind := "invalid_request_error"
+	switch {
+	case status == 401:
+		kind = "authentication_error"
+	case status == 403:
+		kind = "permission_error"
+	case status == 429:
+		kind = "rate_limit_error"
+	case status >= 500:
+		kind = "server_error"
+	}
+	var detail any
+	if code == "file_too_large" {
+		detail = map[string]any{"max_bytes": UHPFileLimit}
+	}
+	writeUHPJSON(w, status, map[string]any{"error": uhpError{Type: kind, Code: code, Message: message, Detail: detail}})
+}
+func uhpWriteError(w http.ResponseWriter, err error) {
+	var a *apiError
+	if errors.As(err, &a) {
+		// Native errors can include host paths/credentials. Only stable boundary
+		// descriptions are exposed; detailed causes stay in the RDCA diagnostic log.
+		code := a.Code
+		messages := map[string]string{"invalid_input": "The request input is invalid.", "harness_not_found": "Harness not found.", "response_not_found": "Response not found.", "session_not_found": "Session not found.", "file_not_found": "File not found.", "session_expired": "The session has expired.", "harness_mismatch": "The configured harness differs from the continued session.", "session_busy": "The session already has a task in progress.", "model_unavailable": "The model is unavailable for this harness.", "file_too_large": "The file exceeds the size limit.", "insufficient_scope": "The credential does not permit this operation.", "preview_unavailable": "This server does not render file previews.", "missing_credential": "A bearer credential is required.", "invalid_credential": "The bearer credential is invalid."}
+		message, ok := messages[code]
+		if !ok {
+			if !strings.HasPrefix(code, "rundesk_") {
+				code = "rundesk_" + code
+			}
+			message = "RunDesk could not perform this operation."
+		}
+		if a.Status == 429 {
+			code = "rate_limited"
+			message = "Task admission is temporarily limited."
+		}
+		if code == "file_too_large" {
+			writeUHPJSON(w, a.Status, map[string]any{"error": uhpError{Type: "invalid_request_error", Code: code, Message: message, Detail: map[string]any{"max_bytes": UHPFileLimit}}})
+			return
+		}
+		uhpFail(w, a.Status, code, message)
+		return
+	}
+	uhpFail(w, 500, "rundesk_storage_error", "The server could not complete this operation.")
+}
+func uhpScope(r *http.Request, scope string) bool {
+	k := principal(r)
+	return k == nil || k.scope(scope)
+}
+
+func (s *Server) uhpBoundary(next http.Handler) http.Handler {
+	u := &uhpService{server: s}
+	mux := http.NewServeMux()
+	u.routes(mux)
+	// Recovery and budgets live with Manager, never with a request/connection.
+	s.Manager.wg.Add(1)
+	go func() {
+		defer s.Manager.wg.Done()
+		ticker := time.NewTicker(100 * time.Millisecond)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-s.Manager.ctx.Done():
+				return
+			case <-ticker.C:
+				u.tick()
+			}
+		}
+	}()
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if !strings.HasPrefix(r.URL.Path, "/v1/") {
+			next.ServeHTTP(w, r)
+			return
+		}
+		w.Header().Set("UHP-Version", UHPVersion)
+		w.Header().Set("X-Content-Type-Options", "nosniff")
+		w.Header().Set("Cache-Control", "no-store")
+		w.Header().Set("Content-Security-Policy", "default-src 'none'; frame-ancestors 'none'")
+		if !s.uhpTransportAllowed(r) {
+			uhpFail(w, 403, "insufficient_scope", "The request origin is not permitted.")
+			return
+		}
+		if version := r.Header.Get("UHP-Version"); version != "" && version != UHPVersion {
+			writeUHPJSON(w, 400, map[string]any{"error": uhpError{Type: "invalid_request_error", Code: "unsupported_protocol_version", Message: "The requested protocol version is unsupported.", Detail: map[string]any{"supported": []string{UHPVersion}}}})
+			return
+		}
+		// Prevent ServeMux's path-clean redirect from turning traversal into an
+		// authenticated request at a different resource.
+		if strings.Contains(r.URL.Path, "\\") || strings.Contains(r.URL.Path, "//") {
+			uhpFail(w, 404, "file_not_found", "Resource not found.")
+			return
+		}
+		for _, seg := range strings.Split(r.URL.Path, "/") {
+			if seg == ".." || seg == "." {
+				uhpFail(w, 404, "file_not_found", "Resource not found.")
+				return
+			}
+		}
+		if r.Method == "GET" && r.URL.Path == "/v1/uhp" {
+			u.discovery(w, r)
+			return
+		}
+		auth := r.Header.Get("Authorization")
+		if auth == "" {
+			uhpFail(w, 401, "missing_credential", "A bearer credential is required.")
+			return
+		}
+		secret, ok := strings.CutPrefix(auth, "Bearer ")
+		if !ok || secret == "" || strings.ContainsAny(secret, " \r\n\t") {
+			uhpFail(w, 401, "invalid_credential", "The bearer credential is invalid.")
+			return
+		}
+		var err error
+		r, err = s.authorize(r)
+		if err != nil || human(r) != nil {
+			uhpFail(w, 401, "invalid_credential", "The bearer credential is invalid.")
+			return
+		}
+		// UHP intentionally accepts service/admin tokens only; human accounts keep
+		// their existing project gate on RDCA rather than bypassing it here.
+		if !uhpScope(r, "read") && r.Method == "GET" {
+			uhpFail(w, 403, "insufficient_scope", "Read scope is required.")
+			return
+		}
+		if r.Method != "GET" && !uhpScope(r, "run") {
+			uhpFail(w, 403, "insufficient_scope", "Run scope is required.")
+			return
+		}
+		if (strings.Contains(r.URL.Path, "/files") || strings.Contains(r.URL.Path, "/containers/")) && !uhpScope(r, "files") {
+			uhpFail(w, 403, "insufficient_scope", "Files scope is required.")
+			return
+		}
+		mux.ServeHTTP(w, r)
+	})
+}
+func (u *uhpService) discovery(w http.ResponseWriter, r *http.Request) {
+	writeUHPJSON(w, 200, map[string]any{"object": "uhp.discovery", "protocol": "uhp", "versions": []string{UHPVersion}, "default_version": UHPVersion, "conformance_class": "core", "capabilities": map[string]bool{"streaming": true, "sessions": true, "cancellation": true, "files_input": true, "files_output": true, "session_listing": true, "harness_management": false, "harness_retirement": false, "input_history": false, "session_sharing": false, "idempotency": true, "plugins": false, "environments": false, "memories": false}, "implementation": map[string]string{"name": "RunDesk", "version": Version, "limitations": "Native tool-round budgets require Kun; images require a supporting Codex model; task instructions use text guidance."}})
+}
+func (u *uhpService) loadResponse(r *http.Request, id string, allowDeleted bool) (uhpRecord, error) {
+	var v uhpRecord
+	err := u.server.Manager.Store.Get("uhp-response", id, &v)
+	if err != nil && !errors.Is(err, sql.ErrNoRows) {
+		return v, err
+	}
+	if err != nil || v.Owner != uhpOwner(r) || (!allowDeleted && v.Deleted) {
+		return v, failure(404, "response_not_found", "")
+	}
+	var ss uhpSessionRecord
+	if err = u.server.Manager.Store.Get("uhp-session", v.SessionID, &ss); err != nil || ss.Deleted {
+		return v, failure(404, "response_not_found", "")
+	}
+	if k := principal(r); k != nil && !k.owns(v.Harness.InstanceID, v.Harness.WorkspaceID, v.Harness.Source) {
+		return v, failure(404, "response_not_found", "")
+	}
+	return v, nil
+}
+func (u *uhpService) loadSession(r *http.Request, id string) (uhpSessionRecord, error) {
+	var v uhpSessionRecord
+	err := u.server.Manager.Store.Get("uhp-session", id, &v)
+	if err != nil && !errors.Is(err, sql.ErrNoRows) {
+		return v, err
+	}
+	if err != nil || v.Deleted || v.Owner != uhpOwner(r) {
+		return v, failure(404, "session_not_found", "")
+	}
+	if k := principal(r); k != nil && !k.owns(v.Harness.InstanceID, v.Harness.WorkspaceID, v.Harness.Source) {
+		return v, failure(404, "session_not_found", "")
+	}
+	return v, nil
+}
+func (u *uhpService) tick() {
+	m := u.server.Manager
+	m.uhpMu.Lock()
+	defer m.uhpMu.Unlock()
+	if m.ctx.Err() != nil {
+		return
+	}
+	rows, err := m.Store.List("uhp-response")
+	if err != nil {
+		return
+	}
+	for _, raw := range rows {
+		var v uhpRecord
+		if json.Unmarshal(raw, &v) != nil || v.Projection.Response.Status != "in_progress" {
+			continue
+		}
+		_ = u.refresh(&v)
+	}
+}
+
+// Caller holds Manager.uhpMu, which serializes every facade projection/admission.
+func (u *uhpService) refresh(v *uhpRecord) error {
+	if v.Projection.Response.Status != "in_progress" {
+		return nil
+	}
+	m := u.server.Manager
+	t, err := u.server.taskControl().Task(v.TaskID)
+	if err != nil {
+		return err
+	}
+	if ss, e := m.Session(t.SessionID); e == nil && ss.RunID == t.RunID && ss.TurnID != "" {
+		v.Projection.NativeTurnID = ss.TurnID
+	}
+	// The session receives its terminal native result before the queue's periodic
+	// reconciliation. Use it to avoid cancelling already-completed work.
+	if ss, e := m.Session(t.SessionID); e == nil && t.RunID != "" && ss.RunID == t.RunID && !active(ss.Status) && t.Status != "queued" {
+		t.Status = ss.Status
+	}
+	if err = u.drainNative(v, t); err != nil {
+		return err
+	}
+	pending := taskPending(t.Status)
+	if pending && v.CancelReason == "" {
+		if v.Deadline > 0 && time.Now().UnixNano() >= v.Deadline {
+			v.CancelReason = "timeout"
+		}
+		if v.MaxStep > 0 && v.Projection.Steps >= v.MaxStep {
+			v.CancelReason = "max_step"
+		}
+	}
+	if pending && v.CancelReason != "" {
+		// Persist intent before issuing a native stop. A crash cannot turn a budget
+		// stop into completed, nor lose the explicit cancellation on restart.
+		if err = m.Store.Put("uhp-response", v.Projection.Response.ID, v); err != nil {
+			return err
+		}
+		if _, err = u.server.taskControl().CancelTask(t.ID); err != nil {
+			return err
+		}
+		t, err = u.server.taskControl().Task(t.ID)
+		if err != nil {
+			return err
+		}
+		pending = taskPending(t.Status)
+	}
+	if !pending {
+		// Stop may emit final fragments while winding down. Observe terminal
+		// state first, then drain through that boundary before freezing output.
+		if err = u.drainNative(v, t); err != nil {
+			return err
+		}
+		status := "failed"
+		var terminalError *uhpError
+		switch t.Status {
+		case "completed":
+			status = "completed"
+		case "interrupted", "canceled", "cancelled":
+			status = "cancelled"
+		}
+		if v.CancelReason == "cancelled" {
+			status = "cancelled"
+		}
+		if v.CancelReason == "timeout" || v.CancelReason == "max_step" {
+			status = "incomplete"
+			v.Projection.Response.IncompleteDetails = map[string]any{"reason": v.CancelReason}
+		}
+		if status == "failed" {
+			terminalError = &uhpError{Type: "harness_error", Code: "harness_error", Message: "The harness could not complete the task. Inspect the RunDesk task diagnostics."}
+		}
+		files, e := (&uhpFiles{Manager: m}).DiscoverArtifacts(v.Owner, v.SessionID, v.HostSessionID, v.ContainerID)
+		if e != nil {
+			v.Projection.Response.Metadata["rundesk_artifacts_unavailable"] = true
+			files = nil
+		}
+		before := map[string]bool{}
+		for _, id := range v.BeforeFiles {
+			before[id] = true
+		}
+		annotations := []map[string]any{}
+		for _, f := range files {
+			if before[f.ID] || f.Availability != "available" {
+				continue
+			}
+			annotations = append(annotations, map[string]any{"type": "container_file_citation", "container_id": f.ContainerID, "file_id": f.ID, "filename": f.Filename, "download_url": "/v1/containers/" + f.ContainerID + "/files/" + f.ID + "/content", "start_index": 0, "end_index": 0})
+		}
+		if len(annotations) > 0 {
+			v.Projection.AddAnnotations(annotations)
+		}
+		v.Projection.Finish(status, terminalError)
+		v.CompletedAt = time.Now().Unix()
+	}
+	return m.Store.Put("uhp-response", v.Projection.Response.ID, v)
+}
+func (u *uhpService) read(r *http.Request, id string) (uhpRecord, error) {
+	return u.readRetained(r, id, false)
+}
+func (u *uhpService) readRetained(r *http.Request, id string, deleted bool) (uhpRecord, error) {
+	m := u.server.Manager
+	m.uhpMu.Lock()
+	defer m.uhpMu.Unlock()
+	v, err := u.loadResponse(r, id, deleted)
+	if err != nil {
+		return v, err
+	}
+	err = u.refresh(&v)
+	return v, err
+}
+func (u *uhpService) wait(r *http.Request, id string) (uhpRecord, error) {
+	ticker := time.NewTicker(50 * time.Millisecond)
+	defer ticker.Stop()
+	for {
+		if !u.server.credentialStillValid(r) {
+			return uhpRecord{}, failure(401, "invalid_credential", "")
+		}
+		v, err := u.readRetained(r, id, true)
+		if err != nil || v.Projection.Response.Status != "in_progress" {
+			return v, err
+		}
+		select {
+		case <-r.Context().Done():
+			return v, r.Context().Err()
+		case <-u.server.Manager.ctx.Done():
+			return v, context.Canceled
+		case <-ticker.C:
+		}
+	}
+}
+func uhpSortedMetadata(in map[string]any, ignored []string, harness, session string) map[string]any {
+	out := map[string]any{}
+	for k, v := range in {
+		out[k] = v
+	}
+	delete(out, "ignored_fields")
+	delete(out, "model_fallback")
+	delete(out, "requested_model")
+	delete(out, "model_fallback_reason")
+	out["harness_id"] = harness
+	out["session_id"] = session
+	if len(ignored) > 0 {
+		sort.Strings(ignored)
+		out["ignored_fields"] = ignored
+	}
+	return out
+}
+
+func (u *uhpService) drainNative(v *uhpRecord, t Task) error {
+	m := u.server.Manager
+	if t.RunID != "" {
+		for {
+			events, e := m.Store.Events(t.SessionID, v.Cursor, 1000)
+			if e != nil {
+				return e
+			}
+			for _, ev := range events {
+				// List views may redact/trim payloads; translation uses the original event.
+				original, e := m.Store.Event(t.SessionID, ev.ID)
+				if e != nil {
+					return e
+				}
+				v.Projection.Apply(original, t.RunID)
+				v.Cursor = ev.ID
+			}
+			if len(events) < 1000 {
+				break
+			}
+		}
+	}
+	return nil
+}
+
+func writeUHPJSON(w http.ResponseWriter, status int, value any) {
+	w.Header().Set("Content-Type", "application/json; charset=utf-8")
+	w.WriteHeader(status)
+	_ = json.NewEncoder(w).Encode(value)
+}
diff --git a/internal/app/uhp_files.go b/internal/app/uhp_files.go
new file mode 100644
index 0000000..dcec8f8
--- /dev/null
+++ b/internal/app/uhp_files.go
@@ -0,0 +1,501 @@
+package app
+
+import (
+	"crypto/sha256"
+	"database/sql"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"io/fs"
+	"net/http"
+	"os"
+	"path"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/shengjuntu/rundesk/internal/resource"
+	"github.com/shengjuntu/rundesk/internal/store"
+)
+
+// Uploads are bounded independently of output artifacts. Artifact downloads use
+// the existing 512 MiB resource-reader limit and never retain another copy.
+const UHPFileLimit int64 = 64 << 20
+
+type uhpFileRecord struct {
+	ID           string `json:"id"`
+	Owner        string `json:"owner"`
+	ContainerID  string `json:"containerId,omitempty"`
+	SessionID    string `json:"sessionId,omitempty"`
+	WorkspaceID  string `json:"workspaceId,omitempty"`
+	Path         string `json:"path,omitempty"`
+	Filename     string `json:"filename"`
+	Bytes        int64  `json:"bytes"`
+	CreatedAt    int64  `json:"createdAt"`
+	SHA256       string `json:"sha256"`
+	Deleted      bool   `json:"deleted,omitempty"`
+	Availability string `json:"availability,omitempty"`
+}
+
+func (f uhpFileRecord) Wire() map[string]any {
+	v := map[string]any{"id": f.ID, "object": "file", "filename": f.Filename, "bytes": f.Bytes, "created_at": f.CreatedAt}
+	if f.ContainerID != "" {
+		v["container_id"] = f.ContainerID
+	}
+	if f.Availability != "" {
+		v["rundesk_availability"] = f.Availability
+	}
+	return v
+}
+
+type uhpFiles struct{ Manager *Manager }
+
+func uhpOpaqueID(id, prefix string) bool {
+	if !strings.HasPrefix(id, prefix) || len(id) <= len(prefix) || len(id) > 128 {
+		return false
+	}
+	for _, c := range id[len(prefix):] {
+		if !(c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_' || c == '-') {
+			return false
+		}
+	}
+	return true
+}
+
+func uhpFileMissing() error { return failure(404, "file_not_found", "File not found.") }
+
+func (f uhpFiles) Record(owner, containerID, id string) (uhpFileRecord, error) {
+	var record uhpFileRecord
+	if owner == "" || !uhpOpaqueID(id, "file_") || (containerID != "" && !uhpOpaqueID(containerID, "cntr_")) {
+		return record, uhpFileMissing()
+	}
+	err := f.Manager.Store.Get("uhp-file", id, &record)
+	if errors.Is(err, sql.ErrNoRows) || (err == nil && (record.Owner != owner || record.ID != id || record.Deleted || record.ContainerID != containerID)) {
+		return uhpFileRecord{}, uhpFileMissing()
+	}
+	return record, err
+}
+
+func (f uhpFiles) uploadPath(record uhpFileRecord) string {
+	return filepath.Join(f.Manager.Data, "uhp", "uploads", record.ID)
+}
+
+// Upload keeps a single original outside workspaces because the upload API does
+// not yet select a harness/workspace. PrepareInput materializes it at most once
+// per workspace, where native runtimes are permitted to read attachments.
+func (f uhpFiles) Upload(owner, filename string, src io.Reader) (uhpFileRecord, error) {
+	if owner == "" {
+		return uhpFileRecord{}, failure(401, "invalid_credential", "A valid bearer token is required.")
+	}
+	f.Manager.libraryMu.Lock()
+	defer f.Manager.libraryMu.Unlock()
+	r := uhpFileRecord{ID: "file_" + store.ID(), Owner: owner, Filename: cleanPersonalName(filename), CreatedAt: time.Now().Unix()}
+	root, err := os.OpenRoot(f.Manager.Data)
+	if err != nil {
+		return r, err
+	}
+	defer root.Close()
+	if err = root.MkdirAll("uhp/uploads", 0700); err != nil {
+		return r, err
+	}
+	p := "uhp/uploads/" + r.ID
+	out, err := root.OpenFile(p, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		return r, err
+	}
+	r.Bytes, r.SHA256, err = uhpCopyInput(out, src)
+	if closeErr := out.Close(); err == nil {
+		err = closeErr
+	}
+	if err == nil {
+		err = f.Manager.Store.Put("uhp-file", r.ID, r)
+	}
+	if err != nil {
+		_ = root.Remove(p)
+	}
+	return r, err
+}
+
+func uhpCopyInput(dst io.Writer, src io.Reader) (int64, string, error) {
+	h := sha256.New()
+	n, err := io.Copy(io.MultiWriter(dst, h), io.LimitReader(src, UHPFileLimit+1))
+	if n > UHPFileLimit {
+		err = failure(413, "file_too_large", "File exceeds the 64 MiB upload limit.")
+	}
+	return n, hex.EncodeToString(h.Sum(nil)), err
+}
+
+// Inline writes the attachment directly into its workspace; there is no second
+// managed upload or snapshot. Only data URLs are supported: arbitrary network
+// fetches would cross the caller's resource and credential boundary.
+func (f uhpFiles) Inline(owner, workspaceID, filename, dataURL string) (string, error) {
+	if owner == "" {
+		return "", failure(401, "invalid_credential", "A valid bearer token is required.")
+	}
+	meta, encoded, ok := strings.Cut(dataURL, ",")
+	if !ok || !strings.HasPrefix(meta, "data:") || !strings.HasSuffix(meta, ";base64") {
+		return "", failure(400, "invalid_input", "Inline files must use a base64 data URL.")
+	}
+	if int64(len(encoded)) > (UHPFileLimit+2)/3*4 {
+		return "", failure(413, "file_too_large", "File exceeds the 64 MiB upload limit.")
+	}
+	f.Manager.libraryMu.Lock()
+	defer f.Manager.libraryMu.Unlock()
+	r := uhpFileRecord{ID: "file_" + store.ID(), Owner: owner, Filename: cleanPersonalName(filename), WorkspaceID: workspaceID, CreatedAt: time.Now().Unix()}
+	w, err := f.Manager.Workspace(workspaceID)
+	if err != nil {
+		return "", err
+	}
+	root, err := os.OpenRoot(w.Path)
+	if err != nil {
+		return "", err
+	}
+	defer root.Close()
+	if err = root.MkdirAll("uploads", 0700); err != nil {
+		return "", err
+	}
+	r.Path = "uploads/" + r.ID + "-" + r.Filename
+	out, err := root.OpenFile(r.Path, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		return "", err
+	}
+	r.Bytes, r.SHA256, err = uhpCopyInput(out, base64.NewDecoder(base64.StdEncoding, strings.NewReader(encoded)))
+	var badEncoding base64.CorruptInputError
+	if errors.As(err, &badEncoding) || errors.Is(err, io.ErrUnexpectedEOF) {
+		err = failure(400, "invalid_input", "Inline file data is not valid base64.")
+	}
+	if closeErr := out.Close(); err == nil {
+		err = closeErr
+	}
+	if err == nil {
+		err = f.Manager.Store.Put("uhp-file", r.ID, r)
+	}
+	if err != nil {
+		_ = root.Remove(r.Path)
+		return "", err
+	}
+	return r.Path, nil
+}
+
+func (f uhpFiles) inputContent(r uhpFileRecord) (*os.File, error) {
+	var src *os.File
+	var err error
+	if r.WorkspaceID != "" {
+		src, err = f.Manager.openArtifactSource(resource.FileSource{WorkspaceID: r.WorkspaceID, Path: r.Path})
+	} else {
+		root, openErr := os.OpenRoot(filepath.Join(f.Manager.Data, "uhp", "uploads"))
+		if openErr != nil {
+			return nil, uhpFileMissing()
+		}
+		defer root.Close()
+		info, statErr := root.Lstat(r.ID)
+		if statErr != nil || !info.Mode().IsRegular() {
+			return nil, uhpFileMissing()
+		}
+		src, err = root.Open(r.ID)
+	}
+	if err != nil {
+		return nil, uhpFileMissing()
+	}
+	size, hash, err := personalDigest(src)
+	if err == nil && (size != r.Bytes || hash != r.SHA256) {
+		err = failure(409, "rundesk_file_changed", "File content changed since it was registered.")
+	}
+	if err != nil {
+		_ = src.Close()
+		return nil, err
+	}
+	return src, nil
+}
+
+func (f uhpFiles) PrepareInput(owner, workspaceID, fileID string) (string, error) {
+	return f.prepareInput(owner, workspaceID, fileID, false)
+}
+
+// Image input is classified from its bytes, never from a caller's filename.
+// Normalize a materialized filename so the native Codex localImage path uses
+// the verified image type even when the uploaded filename was image.bin.
+func (f uhpFiles) PrepareImageInput(owner, workspaceID, fileID string) (string, error) {
+	return f.prepareInput(owner, workspaceID, fileID, true)
+}
+
+func (f uhpFiles) prepareInput(owner, workspaceID, fileID string, image bool) (string, error) {
+	f.Manager.libraryMu.Lock()
+	defer f.Manager.libraryMu.Unlock()
+	r, err := f.Record(owner, "", fileID)
+	if err != nil {
+		return "", err
+	}
+	src, err := f.inputContent(r)
+	if err != nil {
+		return "", err
+	}
+	defer src.Close()
+	ext := ""
+	if image {
+		ext, err = uhpImageExtension(src)
+		if err != nil {
+			return "", err
+		}
+		if _, err = src.Seek(0, io.SeekStart); err != nil {
+			return "", err
+		}
+		r.Filename = strings.TrimSuffix(r.Filename, filepath.Ext(r.Filename)) + ext
+	}
+	if r.WorkspaceID == workspaceID && strings.HasPrefix(r.Path, "uploads/") && (!image || strings.EqualFold(filepath.Ext(r.Path), ext)) {
+		return r.Path, nil
+	}
+	linkID := libraryLinkID(workspaceID, r.ID+ext)
+	var attached uhpFileRecord
+	if err = f.Manager.Store.Get("uhp-file-link", linkID, &attached); err == nil {
+		verified, err := f.inputContent(attached)
+		if err != nil {
+			return "", err
+		}
+		_ = verified.Close()
+		return attached.Path, nil
+	} else if !errors.Is(err, sql.ErrNoRows) {
+		return "", err
+	}
+	w, err := f.Manager.Workspace(workspaceID)
+	if err != nil {
+		return "", err
+	}
+	root, err := os.OpenRoot(w.Path)
+	if err != nil {
+		return "", err
+	}
+	defer root.Close()
+	if err = root.MkdirAll("uploads", 0700); err != nil {
+		return "", err
+	}
+	p := "uploads/" + store.ID() + "-" + r.Filename
+	out, err := root.OpenFile(p, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		return "", err
+	}
+	err = copyPersonalVerified(out, src, PersonalFile{Size: r.Bytes, SHA256: r.SHA256})
+	if closeErr := out.Close(); err == nil {
+		err = closeErr
+	}
+	attached = r
+	attached.WorkspaceID, attached.Path = workspaceID, p
+	if err == nil {
+		err = f.Manager.Store.Put("uhp-file-link", linkID, attached)
+	}
+	if err != nil {
+		_ = root.Remove(p)
+		return "", err
+	}
+	return p, nil
+}
+
+func uhpImageExtension(src io.Reader) (string, error) {
+	var prefix [512]byte
+	n, err := io.ReadFull(src, prefix[:])
+	if err != nil && err != io.EOF && err != io.ErrUnexpectedEOF {
+		return "", failure(400, "invalid_input", "Image data could not be read.")
+	}
+	switch http.DetectContentType(prefix[:n]) {
+	case "image/png":
+		return ".png", nil
+	case "image/jpeg":
+		return ".jpg", nil
+	case "image/webp":
+		return ".webp", nil
+	default:
+		return "", failure(422, "rundesk_image_unsupported", "Image input must contain PNG, JPEG, or WebP bytes.")
+	}
+}
+
+func (f uhpFiles) InlineImage(owner, workspaceID, filename, dataURL string) (string, error) {
+	meta, encoded, ok := strings.Cut(dataURL, ",")
+	if !ok || !strings.HasPrefix(meta, "data:") || !strings.HasSuffix(meta, ";base64") {
+		return "", failure(400, "invalid_input", "Inline images must use a base64 data URL.")
+	}
+	if int64(len(encoded)) > (UHPFileLimit+2)/3*4 {
+		return "", failure(413, "file_too_large", "Image exceeds the 64 MiB upload limit.")
+	}
+	ext, err := uhpImageExtension(base64.NewDecoder(base64.StdEncoding, strings.NewReader(encoded)))
+	if err != nil {
+		return "", err
+	}
+	filename = cleanPersonalName(filename)
+	filename = strings.TrimSuffix(filename, filepath.Ext(filename)) + ext
+	return f.Inline(owner, workspaceID, filename, dataURL)
+}
+
+// DiscoverArtifacts indexes live original files from every turn of the session.
+// Content identity is part of the ID: if a path is overwritten, a historical
+// response cannot accidentally serve the replacement as its earlier artifact.
+func (f uhpFiles) DiscoverArtifacts(owner, sessionID, hostSessionID, containerID string) ([]uhpFileRecord, error) {
+	out := []uhpFileRecord{}
+	if owner == "" || !uhpOpaqueID(containerID, "cntr_") || !uhpOpaqueID(sessionID, "hsess") || !safePath(hostSessionID) || strings.Contains(hostSessionID, "/") {
+		return out, uhpFileMissing()
+	}
+	f.Manager.libraryMu.Lock()
+	defer f.Manager.libraryMu.Unlock()
+	s, err := f.Manager.Session(hostSessionID)
+	if err != nil {
+		return out, err
+	}
+	w, err := f.Manager.Workspace(s.WorkspaceID)
+	if err != nil {
+		return out, err
+	}
+	root, err := os.OpenRoot(w.Path)
+	if err != nil {
+		return out, err
+	}
+	defer root.Close()
+	base := "outputs/" + hostSessionID
+	for _, p := range []string{"outputs", base} {
+		info, err := root.Lstat(p)
+		if os.IsNotExist(err) {
+			return f.artifactHistory(owner, sessionID, out)
+		}
+		if err != nil {
+			return out, err
+		}
+		if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+			return out, failure(409, "rundesk_file_source_invalid", "Artifact directory is unavailable.")
+		}
+	}
+	err = fs.WalkDir(root.FS(), base, func(p string, entry fs.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		if entry.IsDir() || entry.Type()&os.ModeSymlink != 0 {
+			return nil
+		}
+		src, err := f.Manager.openArtifactSource(resource.FileSource{WorkspaceID: s.WorkspaceID, Path: p})
+		if err != nil {
+			return err
+		}
+		size, hash, err := personalDigest(src)
+		_ = src.Close()
+		if err != nil {
+			return err
+		}
+		digest := sha256.Sum256([]byte(owner + "\x00" + sessionID + "\x00" + p + "\x00" + hash))
+		id := "file_" + hex.EncodeToString(digest[:24])
+		var r uhpFileRecord
+		if err = f.Manager.Store.Get("uhp-file", id, &r); errors.Is(err, sql.ErrNoRows) {
+			r = uhpFileRecord{ID: id, Owner: owner, ContainerID: containerID, SessionID: sessionID, WorkspaceID: s.WorkspaceID, Path: p, Filename: strings.TrimPrefix(p, base+"/"), Bytes: size, SHA256: hash, CreatedAt: time.Now().Unix()}
+			err = f.Manager.Store.Put("uhp-file", id, r)
+		}
+		if err != nil {
+			return err
+		}
+		if !r.Deleted {
+			r.Availability = "available"
+			out = append(out, r)
+		}
+		return nil
+	})
+	if err != nil {
+		return out, err
+	}
+	return f.artifactHistory(owner, sessionID, out)
+}
+
+// A session lists its entire file history, including references whose original
+// bytes have since changed or vanished. Their availability is explicit rather
+// than fabricating a historical download or retaining an unsolicited snapshot.
+func (f uhpFiles) artifactHistory(owner, sessionID string, live []uhpFileRecord) ([]uhpFileRecord, error) {
+	byID := map[string]uhpFileRecord{}
+	byPath := map[string]bool{}
+	for _, r := range live {
+		byID[r.ID] = r
+		byPath[r.Path] = true
+	}
+	rows, err := f.Manager.Store.List("uhp-file")
+	if err != nil {
+		return nil, err
+	}
+	for _, row := range rows {
+		var r uhpFileRecord
+		if err := json.Unmarshal(row, &r); err != nil {
+			return nil, err
+		}
+		if r.Owner != owner || r.SessionID != sessionID || r.Deleted {
+			continue
+		}
+		if _, ok := byID[r.ID]; !ok {
+			r.Availability = "missing"
+			if byPath[r.Path] {
+				r.Availability = "changed"
+			}
+			byID[r.ID] = r
+		}
+	}
+	out := make([]uhpFileRecord, 0, len(byID))
+	for _, r := range byID {
+		out = append(out, r)
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if out[i].Filename == out[j].Filename {
+			return out[i].ID < out[j].ID
+		}
+		return out[i].Filename < out[j].Filename
+	})
+	return out, nil
+}
+
+// Content returns a verified transient read buffer, never a retained snapshot.
+// Callers must also authorize the owning UHP session before invoking this method.
+func (f uhpFiles) Content(owner, containerID, id string) (uhpFileRecord, *os.File, func(), error) {
+	r, err := f.Record(owner, containerID, id)
+	if err != nil {
+		return r, nil, nil, err
+	}
+	if r.ContainerID == "" || r.SessionID == "" || !strings.HasPrefix(r.Path, "outputs/") {
+		return r, nil, nil, uhpFileMissing()
+	}
+	src, cleanup, err := f.Manager.openPersonalDownload(PersonalFile{Storage: resource.Reference, Source: &resource.FileSource{WorkspaceID: r.WorkspaceID, Path: r.Path}, Size: r.Bytes, SHA256: r.SHA256})
+	if err != nil {
+		var api *apiError
+		if errors.As(err, &api) && api.Status == 409 {
+			err = failure(409, "rundesk_file_changed", "The original artifact is no longer available in its recorded version.")
+		} else {
+			err = uhpFileMissing()
+		}
+	}
+	return r, src, cleanup, err
+}
+
+// DeleteSession revokes references; the task/session controller owns deletion
+// of session resources. It must never remove a shared workspace here.
+func (f uhpFiles) DeleteSession(owner, sessionID string) error {
+	f.Manager.libraryMu.Lock()
+	defer f.Manager.libraryMu.Unlock()
+	rows, err := f.Manager.Store.List("uhp-file")
+	if err != nil {
+		return err
+	}
+	records := []store.Record{}
+	for _, row := range rows {
+		var r uhpFileRecord
+		if err = json.Unmarshal(row, &r); err != nil {
+			return err
+		}
+		if r.Owner == owner && r.SessionID == sessionID && !r.Deleted {
+			r.Deleted = true
+			records = append(records, store.Record{Kind: "uhp-file", ID: r.ID, Value: r})
+		}
+	}
+	if len(records) == 0 {
+		return nil
+	}
+	return f.Manager.Store.PutMany(records...)
+}
+
+func (f uhpFileRecord) Citation() map[string]any {
+	return map[string]any{"type": "container_file_citation", "container_id": f.ContainerID, "file_id": f.ID, "filename": f.Filename, "download_url": "/v1/containers/" + f.ContainerID + "/files/" + f.ID + "/content", "start_index": 0, "end_index": 0}
+}
+
+// Download filenames never carry directory components into Content-Disposition.
+func (f uhpFileRecord) DownloadName() string { return cleanPersonalName(path.Base(f.Filename)) }
